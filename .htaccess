  RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
  RewriteCond %{THE_REQUEST} \s/+journal-zanzibar-beyond-the-beach\.html[?\s] [NC]
  RewriteRule ^journal-zanzibar-beyond-the-beach\.html$ https://pardusescapes.com/journal/zanzibar-beyond-the-beach/ [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+about/index\.html[?\s] [NC]
  RewriteRule ^about/index\.html$ https://pardusescapes.com/about/ [R=301,L,NE]
  RewriteRule ^about$ https://pardusescapes.com/about/ [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+concept-note/index\.html[?\s] [NC]
  RewriteRule ^concept-note/index\.html$ https://pardusescapes.com/concept-note/ [R=301,L,NE]
  RewriteRule ^concept-note$ https://pardusescapes.com/concept-note/ [R=301,L,NE]
