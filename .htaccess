  RewriteRule ^journal\.html$ https://pardusescapes.com/journal/ [R=301,L,NE]
  RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
  RewriteCond %{THE_REQUEST} \s/+privacy\.html[?\s] [NC]
