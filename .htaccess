  RewriteCond %{THE_REQUEST} \s/+travel-desk/index\.html[?\s] [NC]
  RewriteRule ^travel-desk/index\.html$ https://pardusescapes.com/travel-desk/ [R=301,L,NE]
  RewriteRule ^travel-desk$ https://pardusescapes.com/travel-desk/ [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+destinations/zanzibar/index\.html[?\s] [NC]
  RewriteRule ^destinations/zanzibar/index\.html$ https://pardusescapes.com/destinations/zanzibar/ [R=301,L,NE]
