  RewriteCond %{THE_REQUEST} \s/+corporate\.html[?\s] [NC]
  RewriteRule ^corporate\.html$ https://pardusescapes.com/corporate/ [R=301,L,NE]
  RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
  RewriteCond %{THE_REQUEST} \s/+cruises\.html[?\s] [NC]
  RewriteRule ^cruises\.html$ https://pardusescapes.com/cruises/ [R=301,L,NE]
  RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
  RewriteCond %{THE_REQUEST} \s/+destinations\.html[?\s] [NC]
  RewriteRule ^destinations\.html$ https://pardusescapes.com/destinations/ [R=301,L,NE]
  RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
  RewriteCond %{THE_REQUEST} \s/+journeys\.html[?\s] [NC]
  RewriteRule ^journeys\.html$ https://pardusescapes.com/journeys/ [R=301,L,NE]
  RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
  RewriteCond %{THE_REQUEST} \s/+journey\.html[?\s] [NC]
  RewriteRule ^journey\.html$ https://pardusescapes.com/journey/ [R=301,L,NE]
