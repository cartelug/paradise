  RewriteCond %{THE_REQUEST} \s/+destinations/seychelles/index\.html[?\s] [NC]
  RewriteRule ^destinations/seychelles/index\.html$ https://pardusescapes.com/destinations/seychelles/ [R=301,L,NE]
