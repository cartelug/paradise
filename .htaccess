# PARDUS Luxury Escapes: Apache rules for the website on pardusescapes.com (Namecheap cPanel, public_html).
# These rules cover the website only: HTTPS, the bare domain, the 404 page, caching, compression and image types.
# They do not touch email, webmail, cPanel, /.well-known (SSL certificate checks) or anything outside the website.
# Every block is wrapped in <IfModule>, so a server without a module simply skips that block.

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Certificate validation (AutoSSL) must always reach /.well-known untouched.
  RewriteRule ^\.well-known/ - [L]
  # BEGIN PARDUS CANONICAL ROUTES — generated from routes.mjs
  # Legacy aliases precede any existing-file bypass. Queries are retained.
  RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
  RewriteCond %{THE_REQUEST} \s/+index\.html[?\s] [NC]
  RewriteRule ^index\.html$ https://pardusescapes.com/ [R=301,L,NE]
  RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
  RewriteCond %{THE_REQUEST} \s/+about\.html[?\s] [NC]
  RewriteRule ^about\.html$ https://pardusescapes.com/about/ [R=301,L,NE]
  RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
  RewriteCond %{THE_REQUEST} \s/+concept-note\.html[?\s] [NC]
  RewriteRule ^concept-note\.html$ https://pardusescapes.com/concept-note/ [R=301,L,NE]
  RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
  RewriteCond %{THE_REQUEST} \s/+concierge\.html[?\s] [NC]
  RewriteRule ^concierge\.html$ https://pardusescapes.com/concierge/ [R=301,L,NE]
  RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
  RewriteCond %{THE_REQUEST} \s/+contact\.html[?\s] [NC]
  RewriteRule ^contact\.html$ https://pardusescapes.com/contact/ [R=301,L,NE]
