---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import { navigation, path, site } from '../data/site';
const current = Astro.url.pathname.split('/').pop() || '';
const activeHref = current.startsWith('destination-') ? 'destinations.html' : current.startsWith('journey-') && current !== 'journey.html' ? 'journeys.html' : current.startsWith('journal-') ? 'journal.html' : current;
const primary = [
  { label: 'Destinations', href: 'destinations.html', icon: 'pin' as const, note: 'Islands, safaris and cities' },
  { label: 'Signature journeys', href: 'journeys.html', icon: 'compass' as const, note: 'Ideas to begin a journey with' },
  { label: 'Our difference', href: 'about.html', icon: 'heart' as const, note: 'How Pardus plans and what to expect' },
  { label: 'Corporate travel', href: 'corporate.html', icon: 'briefcase' as const, note: 'Executives, teams and events' },
  { label: 'Journal', href: 'journal.html', icon: 'news' as const, note: 'Notes before you book' },
];
const more = [
  { label: 'Private cruises', href: 'cruises.html', icon: 'anchor' as const },
  { label: 'What we arrange', href: 'concierge.html', icon: 'sparkle' as const },
  { label: 'Travel desk', href: 'travel-desk.html', icon: 'globe' as const },
  { label: 'Contact', href: 'contact.html', icon: 'mail' as const },
];
---
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header" data-header>
  <a href={path()} class="brand-link" aria-label="Pardus Luxury Escapes home"><Brand vector light /></a>
  <nav class="desktop-nav" aria-label="Main navigation">
    {navigation.map(item => <a href={path(item.href)} aria-current={activeHref === item.href ? 'page' : undefined}>{item.label}</a>)}
  </nav>
  <div class="header-tools">
    <button type="button" class="header-saved requires-js" data-folio-trigger aria-haspopup="dialog" aria-controls="pardus-folio"><Icon name="bookmark" /><span>Saved trips</span><small data-folio-count hidden>0</small></button>
    <a class="btn btn--gold btn--sm header-cta" href={path('journey.html')}>Plan your escape</a>
    <button type="button" class="menu-toggle requires-js" aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false" aria-haspopup="dialog"><Icon name="menu" /></button>
  </div>
  <div class="page-progress" aria-hidden="true"><span></span></div>
</header>
<dialog id="mobile-menu" class="menu" aria-label="Menu">
  <div class="menu-panel">
    <div class="menu-top"><a class="brand-link" href={path()} aria-label="Pardus Luxury Escapes home"><Brand vector light /></a><button type="button" class="menu-close" aria-label="Close menu" autofocus><Icon name="close" /></button></div>
    <p class="menu-kicker" style="--i:0">Where to?</p>
    <nav class="menu-nav" aria-label="Mobile navigation">
      {primary.map((item, i) => <a style={`--i:${i + 1}`} href={path(item.href)} aria-current={activeHref === item.href ? 'page' : undefined}><span class="badge"><Icon name={item.icon} /></span><span><strong>{item.label}</strong><small>{item.note}</small></span><Icon name="chevron-right" /></a>)}
    </nav>
    <nav class="menu-more" style="--i:5" aria-label="More from Pardus">
      {more.map(item => <a href={path(item.href)} aria-current={activeHref === item.href ? 'page' : undefined}><Icon name={item.icon} /><span>{item.label}</span></a>)}
    </nav>
    <div class="menu-foot" style="--i:6">
      <a class="btn btn--gold" href={path('journey.html')}>Plan your escape <Icon name="arrow-right" /></a>
      <button type="button" class="btn btn--ghost requires-js" data-folio-trigger aria-haspopup="dialog" aria-controls="pardus-folio"><Icon name="bookmark" /> Saved trips</button>
      <a class="menu-contact" href={`mailto:${site.bookingsEmail}`}><Icon name="mail" /><span>{site.bookingsEmail}</span></a>
    </div>
  </div>
</dialog>
