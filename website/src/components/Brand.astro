---
import { path } from '../data/site';
interface Props { class?: string; light?: boolean; mark?: boolean; vector?: boolean; }
const { class: className, light = false, mark = false, vector = false } = Astro.props;
---
{mark ? (
  <svg class:list={['brand-svg', className, { 'brand-light': light, 'brand-symbol': mark }]} viewBox="150 0 690 150" fill="none" aria-hidden="true" focusable="false">
    <use href="#pardus-leopard" />
  </svg>
) : vector ? (
  /* Transparent HD Pardus logo, with separate light and primary colourways. */
  <span class:list={['brand-lockup-vector', className, { 'brand-light': light }]} aria-hidden="true">
    <img class="brand-svg" src={path(light ? 'brand/pardus-light.svg' : 'brand/pardus-primary.svg')} width="1942" height="809" alt="" decoding="async" />
  </span>
) : (
  <span class:list={['brand-lockup', className, { 'brand-on-dark': light }]} aria-hidden="true">
    <img src={path(light ? 'brand/pardus-light.svg' : 'brand/pardus-primary.svg')} width="1942" height="809" alt="" decoding="async" />
  </span>
)}
