---
import { path } from '../data/site';
import artwork from '../data/hero-artwork.json';
const srcset=(name:'desktop'|'mobile',format:'webp'|'avif')=>artwork[name].widths.map(width=>path('images/hero-v27-'+name+'-'+width+'.'+format)+' '+width+'w').join(', ');
---
<div class="hero-artwork" data-leopard-scene
  data-leopard-blink={path('images/hero-v27-desktop-blink.webp')}
  data-leopard-blink-portrait={path('images/hero-v27-mobile-blink.webp')}>
  <picture class="hero-artwork-fallback">
    <source media="(max-width: 1100px)" type="image/avif" srcset={srcset('mobile','avif')} sizes="(max-width: 760px) 667px, 100vw" />
    <source media="(max-width: 1100px)" type="image/webp" srcset={srcset('mobile','webp')} sizes="(max-width: 760px) 667px, 100vw" />
    <source type="image/avif" srcset={srcset('desktop','avif')} sizes="100vw" />
    <img src={path('images/hero-v27-desktop-'+artwork.desktop.width+'.webp')} srcset={srcset('desktop','webp')} sizes="100vw"
      width={artwork.desktop.width} height={artwork.desktop.height}
      alt="Illustrative Pardus campaign scene: a leopard resting on a coastal terrace above island villas and a private yacht at blue hour"
      loading="eager" fetchpriority="high" decoding="async" data-hero-image data-leopard-background />
  </picture>
  <canvas class="hero-film" data-leopard-canvas aria-hidden="true"></canvas>
</div>
