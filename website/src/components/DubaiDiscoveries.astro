---
import Picture from './Picture.astro';
import Icon from './Icon.astro';
import { dubaiDiscoveries } from '../data/dubai-gallery';
---
<section class="sec sec--ivory" aria-labelledby="dubai-discoveries-title">
  <div class="wrap">
    <div class="sec-head">
      <h2 id="dubai-discoveries-title" data-split>See a little more of Dubai.</h2>
      <p>Waterfront mornings, city evenings and time between them. Tell us what draws you here.</p>
    </div>
    <div class="dubai-discoveries" data-stagger="90">
      {dubaiDiscoveries.map(place => <article class="dubai-place" data-reveal>
        <div class="frame"><Picture name={place.image} alt={place.alt} sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 45vw" /></div>
        <div class="dubai-place-copy"><h3><Icon name={place.icon} /><span>{place.title}</span></h3><p>{place.text}</p></div>
      </article>)}
    </div>
    <p class="note dubai-illustration-note">These illustrative scenes offer inspiration. Your proposal confirms the actual places, stays and experiences for your dates.</p>
  </div>
</section>
<style>
  .dubai-discoveries { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(24px, 3.5vw, 52px); }
  .dubai-place { min-width: 0; }
  .dubai-place .frame { aspect-ratio: 3 / 2; }
  .dubai-place-copy { padding-top: clamp(18px, 2vw, 26px); }
  .dubai-place h3 { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
  .dubai-place h3 span { min-width: 0; }
  .dubai-place h3 :global(.icon) { flex: none; width: 23px; height: 23px; color: var(--gold-ink); }
  .dubai-place p { max-width: 60ch; color: var(--ink-2); }
  .dubai-illustration-note { max-width: 78ch; margin-top: 32px; }
  @media (max-width: 640px) { .dubai-discoveries { grid-template-columns: minmax(0, 1fr); gap: 32px; } }
</style>
