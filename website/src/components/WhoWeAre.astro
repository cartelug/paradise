---
import Icon from './Icon.astro';
import ArtHeading from './ArtHeading.astro';
import { path } from '../data/site';
import '../styles/who-we-are.css';
const original = (name: string) => path(`images/pardus-who-${name}.webp`);
const clean = (name: string) => path(`images/pardus-v37-who-${name}.webp`);
const set = (scene: string, cleaned = false) => (scene === 'mobile' ? [480, 853] : [960, 1536]).map(w => `${cleaned ? clean(`${scene}-${w}`) : original(`${scene}-${w}`)} ${w}w`).join(', ');
const services = [{ name: 'Flights', icon: 'plane' }, { name: 'Stays', icon: 'bed' }, { name: 'Safaris', icon: 'compass' }, { name: 'Private experiences', icon: 'yacht' }] as const;
---
<section class="who-reference" id="who-we-are" aria-labelledby="who-title" data-who-reference style={`--who-mask-desktop:url('${path('images/pardus-v37-who-mask-desktop.svg')}');--who-mask-mobile:url('${path('images/pardus-v37-who-mask-mobile.svg')}')`}>
  <div class="who-reference-stage">
    <div class="who-backdrop" aria-hidden="true">
      <picture class="who-reference-picture">
        <source media="(max-width: 999px)" srcset={set('mobile')} sizes="100vw" width="853" height="1844" />
        <img src={original('desktop-1536')} srcset={set('desktop')} sizes="100vw" width="1536" height="1024" alt="" loading="lazy" decoding="async" data-who-base />
      </picture>
      <picture class="who-cleanup-picture">
        <source media="(max-width: 999px)" srcset={set('mobile', true)} sizes="100vw" width="853" height="1844" />
        <img src={clean('desktop-1536')} srcset={set('desktop', true)} sizes="100vw" width="1536" height="1024" alt="" loading="lazy" decoding="async" data-who-image />
      </picture>
    </div>
    <div class="who-reference-copy">
      <p class="who-reference-label">02 / Who we are</p>
      <ArtHeading as="h2" id="who-title" art="who-lettering">A world of places. <em>A journey of your own.</em></ArtHeading>
      <div class="who-native-copy">
        <p class="who-reference-intro">We are Pardus Luxury Escapes.</p>
        <p class="who-reference-description">We arrange flights, stays, safaris and private experiences across Africa and around the world.</p>
        <a class="who-reference-action" href={path('about.html')}><span>Discover Pardus</span><Icon name="arrow-right" /></a>
      </div>
    </div>
    <ul class="who-reference-services" aria-label="What we arrange">{services.map(service => <li><Icon name={service.icon} /><span>{service.name}</span></li>)}</ul>
    <span class="who-reference-rem" aria-hidden="true"></span>
  </div>
</section>
<script>import '../scripts/who-we-are';</script>
