---
import logo from '../data/logo.json';
---
<div class="pardus-intro atelier-intro" data-pardus-intro role="dialog" aria-modal="true" aria-label="Pardus introduction">
  <div class="atelier-intro-atmosphere" aria-hidden="true"></div>
  <div class="atelier-intro-top" aria-hidden="true"><span>From Africa to the world</span><span>Luxury, made personal</span></div>
  <div class="atelier-intro-centre">
    <svg class="atelier-intro-logo" viewBox="0 0 920 385" aria-hidden="true" focusable="false">
      <g class="atelier-intro-trace" fill="none" stroke="#d4b780" stroke-width="1.6"><path d={logo.leopard} pathLength="1" /></g>
      <g class="atelier-intro-emblem" fill="#d4b780"><path d={logo.leopard} fill-rule="evenodd" /></g>
      {logo.letters.map((d,i)=><g class="atelier-intro-letter" style={'--letter-index:'+i} fill="#f6f2e9"><path d={d} fill-rule="evenodd" /></g>)}
      <g class="atelier-intro-plane" fill="#d4b780"><path d={logo.plane} fill-rule="evenodd" /></g>
      <g class="atelier-intro-tagline" fill="#d4b780"><path d={logo.tagline} fill-rule="evenodd" /></g>
    </svg>
    <p class="atelier-intro-caption">Extraordinary places. Beautifully arranged.</p>
    <div class="atelier-intro-progress" aria-hidden="true"><span></span></div>
  </div>
  <div class="atelier-intro-bottom"><span>Every journey begins with a possibility.</span><button type="button" data-skip-intro>Skip introduction <span aria-hidden="true">↗</span></button></div>
</div>
