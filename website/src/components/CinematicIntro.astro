---
import logo from '../data/logo.json';
---
<div class="pardus-intro" data-pardus-intro role="dialog" aria-modal="true" aria-label="Pardus animated introduction">
  <div class="intro-atmosphere" aria-hidden="true"></div>
  <div class="intro-curtain intro-curtain-left" aria-hidden="true"></div><div class="intro-curtain intro-curtain-right" aria-hidden="true"></div>
  <svg class="intro-world" viewBox="0 0 800 800" aria-hidden="true" focusable="false">
    <defs><radialGradient id="intro-world-fade"><stop offset="0" stop-color="#d7ba7d" stop-opacity=".28"/><stop offset="1" stop-color="#d7ba7d" stop-opacity=".04"/></radialGradient></defs>
    <g fill="none" stroke="url(#intro-world-fade)" stroke-width=".7"><circle cx="400" cy="400" r="326"/><ellipse cx="400" cy="400" rx="225" ry="326"/><ellipse cx="400" cy="400" rx="110" ry="326"/><ellipse cx="400" cy="400" rx="326" ry="215"/><ellipse cx="400" cy="400" rx="326" ry="100"/><path d="M74 400H726M400 74V726"/></g>
    <g class="intro-route-lines" fill="none" stroke="#d7ba7d" stroke-width="1" stroke-opacity=".4"><path d="M121 531Q273 136 651 254" pathLength="1"/><path d="M191 185Q707 235 665 581" pathLength="1"/><path d="M138 623Q535 712 672 344" pathLength="1"/></g>
    <circle class="intro-world-orbit" cx="400" cy="400" r="350" fill="none" stroke="#d7ba7d" stroke-width="1" stroke-dasharray="2 22" stroke-opacity=".25"/>
  </svg>
  <div class="intro-orbit" aria-hidden="true"></div><div class="intro-orbit intro-orbit-second" aria-hidden="true"></div>
  <div class="intro-topline" aria-hidden="true"><span>Pardus Luxury Escapes</span><span>From Africa to the world</span></div>
  <div class="intro-centre">
    <svg class="intro-logo" viewBox="-20 -15 960 430" aria-hidden="true" focusable="false">
      <defs><linearGradient id="intro-metal" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#967343"/><stop offset=".38" stop-color="#f3dfb0"/><stop offset=".6" stop-color="#d8b578"/><stop offset="1" stop-color="#a9854d"/></linearGradient><linearGradient id="intro-sheen"><stop offset="0" stop-color="#fff4d2" stop-opacity="0"/><stop offset=".5" stop-color="#fff4d2" stop-opacity=".9"/><stop offset="1" stop-color="#fff4d2" stop-opacity="0"/></linearGradient><clipPath id="intro-logo-mask"><path d={logo.leopard} fill-rule="evenodd"/>{logo.letters.map(d=><path d={d} fill-rule="evenodd"/>)}<path d={logo.plane} fill-rule="evenodd"/></clipPath></defs>
      <g class="intro-trace" fill="none" stroke="url(#intro-metal)" stroke-width="1.8"><path d={logo.leopard} pathLength="1"/></g>
      <g class="intro-leopard-fill" fill="url(#intro-metal)"><path d={logo.leopard} fill-rule="evenodd"/></g>
      <g class="intro-word-trace" fill="none" stroke="#eee7d6" stroke-width=".9">{logo.letters.map(d=><path d={d} pathLength="1"/>)}</g>
      <g class="intro-word-fill" fill="#f7f6f1">{logo.letters.map(d=><path d={d} fill-rule="evenodd"/>)}</g>
      <g class="intro-aircraft" fill="url(#intro-metal)"><path d={logo.plane} fill-rule="evenodd"/></g>
      <g class="intro-tagline" fill="#d7b97d"><path d={logo.tagline} fill-rule="evenodd"/></g>
      <g clip-path="url(#intro-logo-mask)"><rect class="intro-metal-sheen" x="-400" y="-100" width="190" height="650" fill="url(#intro-sheen)" transform="rotate(-18)"/></g>
    </svg>
    <p class="intro-promise"><span>Luxury travel.</span><em>Beautifully arranged.</em></p>
    <div class="intro-progress" aria-hidden="true"><span></span></div>
    <p class="intro-destinations" aria-hidden="true">Islands <span>·</span> Safaris <span>·</span> City escapes</p>
  </div>
  <div class="intro-bottomline"><span>Your escape begins here.</span><button type="button" data-skip-intro>Skip introduction</button></div>
</div>
