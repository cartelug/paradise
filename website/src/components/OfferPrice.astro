---
import { usd, type EscapeOffer } from '../data/offers';
interface Props { offer: Pick<EscapeOffer,'fromUSD'|'priceBasis'>; }
const { offer } = Astro.props;
---
<div class="offer-price">{offer.fromUSD !== null && <span class="price-label">From</span>}<strong>{offer.fromUSD === null ? 'Quote on request' : usd(offer.fromUSD)}</strong>{offer.fromUSD !== null && <small>{offer.priceBasis}</small>}</div>
