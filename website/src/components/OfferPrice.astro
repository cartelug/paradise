---
import { displayPrice, type EscapeOffer } from '../data/offers';
interface Props { offer: Pick<EscapeOffer,'fromUSD'|'fromUGX'|'priceBasis'>; }
const { offer } = Astro.props;
const price = displayPrice(offer);
---
<div class="price">
  {price.hasStartingPrice && <span class="price-label">From</span>}
  <strong>{price.amount}</strong>
  {price.hasStartingPrice && <small>{offer.priceBasis}</small>}
  {price.secondary && <small>{price.secondary} reference</small>}
  {price.currency !== 'UGX' && <small>UGX quote available</small>}
</div>
