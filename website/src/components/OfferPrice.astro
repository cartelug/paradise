---
import { displayPrice, promotionPrice, type EscapeOffer } from '../data/offers';
interface Props { offer: EscapeOffer; }
const { offer } = Astro.props;
const price = displayPrice(offer);
const promotion = promotionPrice(offer);
---
<div class:list={['price', { 'price--request': !price.hasStartingPrice }]}>
  {price.hasStartingPrice && <span class="price-label">From</span>}
  <strong>{price.amount}</strong>
  {promotion && <span class="price-promotion"><del>Was {promotion.amount}</del><small>Offer: <time datetime={promotion.startsOn}>{promotion.startsOn}</time> to <time datetime={promotion.endsOn}>{promotion.endsOn}</time></small></span>}
  {price.hasStartingPrice && <small>{offer.priceBasis}</small>}
  {price.secondary && <small>{price.secondary} reference</small>}
  {price.currency !== 'UGX' && <small>UGX quote available</small>}
</div>
