---
import data from '../../public/travel-updates.json';
import { path } from '../data/site';
import { formatTravelDate as date, selectTravelUpdates, travelFeedStatus } from '../data/travel-updates';
interface Props { limit?: number; }
const { limit = 6 } = Astro.props;
const items = selectTravelUpdates(data.items, limit);
---
<div data-travel-desk data-limit={limit} data-local-feed={path('travel-updates.json')}>
  <p class="travel-desk-status" data-feed-status>{travelFeedStatus(data.updatedAt)}</p>
  <div class="travel-desk-grid" data-feed-items>{items.map(item => <article class="travel-update"><div class="travel-update-meta"><span>{item.category}</span><time datetime={item.publishedAt}>Published {date(item.publishedAt)}</time></div><h3>{item.title}</h3><p>{item.summary}</p><a href={item.url} target="_blank" rel="noopener noreferrer">Read at {item.source}</a></article>)}</div>
  <p class="travel-desk-note" data-feed-empty hidden={items.length > 0}>No recent traveller notices are available here. Check the <a href="https://caa.go.ug/" target="_blank" rel="noopener noreferrer">Uganda CAA notices</a> and <a href="https://www.visitdubai.com/en/festivals-and-events/dubai-events-calendar" target="_blank" rel="noopener noreferrer">official Dubai events calendar</a> for your dates.</p>
  <p class="travel-desk-note">Updates link to official sources. Entry requirements and offers can change; check the original notice for your nationality, route and travel dates.</p>
</div>
<script>import '../scripts/travel-desk';</script>
