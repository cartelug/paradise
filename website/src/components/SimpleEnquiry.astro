---
import Icon from './Icon.astro';
import { destinations } from '../data/destinations';
import { site, path } from '../data/site';
interface Props { id?: string; defaultDestination?: string; }
const { id = 'escape-enquiry', defaultDestination = '' } = Astro.props;
---
<form class="form" data-escape-enquiry data-recipient={site.bookingsEmail} data-delivery={site.enquiryEndpoint ? 'online' : 'email'}>
  <div class="form" data-enquiry-fields>
  <div class="form-grid">
    <div class="field"><label for={`${id}-destination`}>Where would you like to go?</label><select id={`${id}-destination`} name="destination"><option>Help me choose</option>{destinations.map(d => <option selected={defaultDestination === d.name}>{d.name}</option>)}<option selected={defaultDestination === 'Ocean cruise'}>Ocean cruise</option><option selected={defaultDestination === 'Private boat & yacht experience'}>Private boat & yacht experience</option><option>Somewhere else</option></select></div>
    <div class="field"><label for={`${id}-date`}>Preferred departure <span>(optional)</span></label><input id={`${id}-date`} name="date" type="date" /></div>
    <div class="field"><label for={`${id}-travellers`}>Travellers</label><select id={`${id}-travellers`} name="travellers"><option>2 travellers</option><option>1 traveller</option><option>3–4 travellers</option><option>5–8 travellers</option><option>9+ travellers</option></select></div>
    <div class="field"><label for={`${id}-budget`}>Budget per person in UGX</label><select id={`${id}-budget`} name="budget"><option>Let’s discuss</option><option>Under UGX 5,000,000</option><option>UGX 5,000,000–10,000,000</option><option>UGX 10,000,000–20,000,000</option><option>UGX 20,000,000+</option></select></div>
    <div class="field"><label for={`${id}-name`}>Your name</label><input id={`${id}-name`} name="name" autocomplete="name" maxlength="100" required aria-required="true" /></div>
    <div class="field"><label for={`${id}-email`}>Your email</label><input id={`${id}-email`} name="email" type="email" autocomplete="email" maxlength="200" required aria-required="true" /></div>
    <div class="field field--wide"><label for={`${id}-phone`}>Phone or WhatsApp <span>(optional)</span></label><input id={`${id}-phone`} name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="40" placeholder="+256 700 000 000" aria-describedby={`${id}-phone-hint`} /><small class="field-hint" id={`${id}-phone-hint`}>Include the country code if you would like to be reached on WhatsApp.</small></div>
  </div>
  <div class="field"><label for={`${id}-notes`}>Anything you have in mind? <span>(optional)</span></label><textarea id={`${id}-notes`} name="notes" rows="3" maxlength="1500" placeholder="A honeymoon, family holiday, private cruise, or a place you have always wanted to visit…"></textarea></div>
  <div class="form-actions"><button class="btn btn--gold requires-js" type="submit"><Icon name={site.enquiryEndpoint ? 'arrow-right' : 'mail'} /> {site.enquiryEndpoint ? 'Send my enquiry' : 'Prepare my email enquiry'}</button><button class="btn btn--ghost requires-js" type="button" data-download-enquiry><Icon name="download" /> Save a copy</button><noscript><a class="btn btn--gold" href={`mailto:${site.bookingsEmail}?subject=Pardus%20travel%20enquiry`}>Email your travel enquiry</a></noscript></div>
  <p class="form-note">{site.enquiryEndpoint ? 'Your enquiry goes straight to the Pardus travel team, and we reply by email. Saving a copy is optional and does not send anything. This does not make a booking.' : 'Opens a draft in your email app. Send it there to contact Pardus. This does not make a booking.'} <a href={path('privacy.html')}>Privacy</a></p>
  </div>
  <p class="form-status" data-enquiry-status role="status" aria-live="polite"></p>
  <div class="form-thanks" data-enquiry-thanks tabindex="-1" hidden>
    <span class="badge" aria-hidden="true"><Icon name="check" /></span>
    <h3>Thank you<span data-thanks-name></span>. Your enquiry has been sent.</h3>
    <p>It has reached the Pardus travel team. We will reply by email to <strong data-thanks-email></strong> with the next step. Nothing has been booked or charged.</p>
    <div class="form-actions"><button class="btn btn--ghost" type="button" data-download-enquiry><Icon name="download" /> Save a copy</button><button class="btn btn--ghost" type="button" data-enquiry-again>Send another enquiry</button></div>
  </div>
</form>
<script>import '../scripts/enquiry';</script>
