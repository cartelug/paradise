---
import Icon from './Icon.astro';
import { path } from '../data/site';
import { offerFor, displayPrice, priceText, cruiseTypes } from '../data/offers';
import layers from '../data/hero-layers.json';
// The V25 hero, rebuilt in layers so the leopard can move on its own: a clean world plate, the animal, a blink patch
// for the eyes, glow and light effects, and a small canvas of drifting motes. Everything is positioned in image
// coordinates, so the artwork looks exactly as approved at rest and the animal never moves out of its place.
const rail = ['maldives', 'seychelles', 'dubai'].map(slug => offerFor(slug));
const asset = (name: string) => path(`images/${name}`);
const set = (prefix: string, sizes: number[], ext: string) => sizes.map(w => `${asset(`${prefix}-${w}.${ext}`)} ${w}w`).join(', ');
// Portrait artwork is used on phones and on any screen that is not clearly landscape, so the copy never sits on the animal.
const stacked = '(max-width: 760px), (max-aspect-ratio: 11/10)';
const { leopard } = layers;
const nightsOf = (text: string) => { const n = text.match(/(\d+)-night/); return n ? `${n[1]} nights` : text; };
// What Pardus arranges, in one glance (the full list of 13 is in "What we arrange").
const arranges = [
  { icon: 'plane', label: 'Flights' }, { icon: 'bed', label: 'Hotels' }, { icon: 'car', label: 'Transfers' },
  { icon: 'passport', label: 'Visas' }, { icon: 'yacht', label: 'Yachts' }, { icon: 'paw', label: 'Safaris' },
] as const;
// Places in the picture, in order of priority when space is short. Coordinates are percentages of the world plate: d = landscape art, m = portrait art.
// side / mside = where the label opens. `stacked: false` hides a pin on phones and portrait screens, where it would meet
// the leopard, the buttons or another pin.
const dubai = offerFor('dubai'), maldives = offerFor('maldives'), yacht = cruiseTypes[0];
const spots = [
  { key: 'maldives', href: path('destination-maldives.html'), title: 'Maldives', meta: [nightsOf(maldives.nights), priceText(maldives).replace('From', 'from')], d: [58.5, 51.5], m: [28.5, 55], side: 'below', mside: 'below', stacked: true },
  { key: 'dubai', href: path('destination-dubai.html'), title: 'Dubai', meta: [nightsOf(dubai.nights), priceText(dubai).replace('From', 'from')], d: [58.5, 27.5], m: [80.5, 43], side: 'above', mside: 'above', stacked: false },
  { key: 'yacht', href: path('cruises.html'), title: 'Private yacht', meta: [yacht.basis.match(/\d+ hours?/)?.[0] ?? 'Private charter', `${priceText(yacht).replace('From', 'from')} per yacht`], d: [47.5, 37.5], m: [23.5, 49.5], side: 'right', mside: 'below', stacked: false },
];
const vars = `--leopard-url:url(${asset('pardus-leopard-v30-mask.webp')})`;
---
<section class="hero" aria-labelledby="hero-title" data-hero data-hero-life>
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="wrap hero-inner">
    <div class="hero-copy" data-hero-copy>
      <p class="eyebrow">From Africa to the world</p>
      <h1 id="hero-title"><span class="line" style="--n:0"><span>Luxury travel,</span></span><span class="line" style="--n:1"><span><em>beautifully</em></span></span><span class="line" style="--n:2"><span>arranged.</span></span></h1>
      <p class="hero-text">You choose where. <strong>We arrange everything.</strong></p>
      <ul class="hero-services" aria-label="What Pardus arranges">
        {arranges.map(item => <li><Icon name={item.icon} />{item.label}</li>)}
        <li class="hero-services-more"><a href="#what-we-arrange">+7 more</a></li>
      </ul>
      <div class="actions"><a class="btn btn--gold" href="#destinations" aria-label="Explore destinations"><span>Explore<span class="btn-long"> destinations</span></span> <Icon name="arrow-down" /></a><a class="btn btn--ghost" href={path('journey.html')} aria-label="Plan your escape"><span>Plan <span class="btn-mid">your </span>escape</span> <Icon name="arrow-right" /></a></div>
    </div>
    <div class="hero-zone">
      <div class="hero-media">
        <div class="hero-picture" style={vars}>
          <div class="hero-drift">
            <picture class="hl-world">
              <source media={stacked} type="image/avif" srcset={set('pardus-world-mobile-v30', [480, 768, 1024], 'avif')} sizes="100vw" />
              <source media={stacked} type="image/webp" srcset={set('pardus-world-mobile-v30', [480, 768, 1024], 'webp')} sizes="100vw" />
              <source type="image/avif" srcset={set('pardus-world-desktop-v30', [640, 1280, 1536], 'avif')} sizes="100vw" />
              <img src={asset('pardus-world-desktop-v30-1536.webp')} srcset={set('pardus-world-desktop-v30', [640, 1280, 1536], 'webp')} sizes="100vw" width="1536" height="1024" alt="A leopard watching over a turquoise lagoon with overwater villas, a white yacht and a golden city skyline at sunset" fetchpriority="high" decoding="async" data-hero-image />
            </picture>
            <span class="hero-glow" aria-hidden="true"></span>
            <div class="hl-leopard" data-leopard aria-hidden="true">
              <div class="hl-breath">
                <picture class="hl-body">
                  <source type="image/avif" srcset={asset('pardus-leopard-v30.avif')} />
                  <img src={asset('pardus-leopard-v30.webp')} width={leopard.size.width} height={leopard.size.height} alt="" fetchpriority="high" decoding="async" data-hero-image />
                </picture>
                <picture class="hl-eyes" data-leopard-eyes>
                  <source type="image/avif" srcset={asset('pardus-leopard-v30-eyes.avif')} />
                  <img src={asset('pardus-leopard-v30-eyes.webp')} width="310" height="105" alt="" decoding="async" />
                </picture>
                <span class="hl-glows"><span class="hl-glow hl-glow--l"></span><span class="hl-glow hl-glow--r"></span></span>
                <span class="hl-rim"></span>
                <span class="leopard-box" data-leopard-box></span>
              </div>
            </div>
            <canvas class="hl-motes" data-hero-motes aria-hidden="true"></canvas>
            <nav class="hl-spots" aria-label="Places in the picture" data-hero-spots>
              {spots.map((spot, k) => (
                <a class="spot" href={spot.href} data-spot={spot.key} data-side={spot.side} data-mside={spot.mside} data-stacked={String(spot.stacked)} style={`--dx:${spot.d[0]}%;--dy:${spot.d[1]}%;--mx:${spot.m[0]}%;--my:${spot.m[1]}%;--k:${k};--mk:${spots.filter(other => other.stacked).indexOf(spot)}`}>
                  <span class="spot-dot" aria-hidden="true"></span>
                  <span class="spot-label"><strong>{spot.title}</strong><span class="spot-meta">{spot.meta.map(part => <span>{part}</span>)}</span></span>
                </a>
              ))}
            </nav>
          </div>
        </div>
      </div>
    </div>
    <div class="hero-rail glass" data-hero-rail>
      <div class="hero-rail-head"><span><strong>Three ways to escape.</strong> Per person, two sharing.</span>
        <button type="button" class="motion-toggle requires-js" data-scene-motion aria-pressed="false" aria-label="Pause background animation"><Icon name="pause" class="icon-pause" /><Icon name="play" class="icon-play" /><span data-scene-motion-label>Pause scene</span></button>
      </div>
      <nav class="hero-offers" aria-label="Popular escapes and starting prices">
        {rail.map((offer, index) => {
          const price = displayPrice(offer);
          return <a href={path(`destination-${offer.slug}.html`)} style={`--i:${index}`}>
            <span class="offer-thumb" aria-hidden="true"><img src={asset(`pardus-thumb-${offer.slug}.webp`)} width="256" height="256" alt="" loading="lazy" decoding="async" /></span>
            <span class="name">{offer.label}<small>{nightsOf(offer.nights)}</small></span>
            <strong class="amount"><span class="from">From</span> {price.amount}</strong>
            <span class="offer-go" aria-hidden="true"><Icon name="arrow-right" /></span>
          </a>;
        })}
      </nav>
    </div>
  </div>
</section>
<script>import '../scripts/hero-life.ts';</script>
