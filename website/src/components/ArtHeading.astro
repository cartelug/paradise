---
interface Props { as: 'h1' | 'h2'; id: string; art: 'hero-lettering' | 'escape-lettering'; reveal?: boolean; }
const { as: Tag, id, art, reveal = false } = Astro.props as Props;
---
<Tag id={id} class="art-heading" data-art-heading data-art-key={art} data-reveal={reveal ? true : undefined}>
  <span class="art-heading-copy"><slot /></span>
</Tag>
