---
import { path } from '../data/site';
import artwork from '../data/illustrated-home-artwork.json';
interface Props { as: 'h1' | 'h2'; id: string; art: 'hero-lettering' | 'escape-lettering' | 'who-lettering'; reveal?: boolean; }
const { as: Tag, id, art, reveal = false } = Astro.props as Props;
const meta = artwork.lettering[art];
const phone = art === 'who-lettering' ? artwork.lettering['who-lettering-mobile'] : null;
const asset = (width: number) => path(`images/${'prefix' in meta ? meta.prefix : 'pardus-v34'}-${art}-${width}.webp`);
const phoneAsset = (width: number) => path(`images/pardus-v37-who-lettering-mobile-${width}.webp`);
---
<Tag id={id} class="art-heading" data-art-heading data-art-key={art} data-reveal={reveal ? true : undefined}>
  <span class="art-heading-copy"><slot /></span>
  <span class="art-heading-visual" aria-hidden="true" style={`--art-mask:url('${asset(960)}');--art-mask-mobile:url('${phone ? phoneAsset(960) : asset(960)}')`}>
    {phone ? <picture><source media="(max-width: 767px)" srcset={phone.widths.map(width => `${phoneAsset(width)} ${width}w`).join(', ')} sizes="90vw" width={phone.width} height={phone.height} /><img src={asset(960)} srcset={meta.widths.map(width => `${asset(width)} ${width}w`).join(', ')} sizes="(max-width: 999px) 90vw, 62vw" width={meta.width} height={meta.height} alt="" loading="lazy" decoding="async" data-lettering-image /></picture> :
    <img src={asset(960)} srcset={meta.widths.map(width => `${asset(width)} ${width}w`).join(', ')} sizes={art === 'who-lettering' ? '(max-width: 999px) 90vw, 62vw' : Tag === 'h1' ? '(max-width: 767px) 90vw, 46vw' : '(max-width: 767px) 88vw, 42vw'} width={meta.width} height={meta.height} alt="" loading={Tag === 'h1' ? 'eager' : 'lazy'} decoding="async" data-lettering-image />
    }
  </span>
</Tag>
