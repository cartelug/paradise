---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import { path, site, socialLinks } from '../data/site';
import { destinations } from '../data/destinations';
interface Props { simple?: boolean; }
const { simple = false } = Astro.props;
---
{!simple && <section class="closing sec--night" aria-labelledby="closing-title">
  <div class="wrap">
    <p class="eyebrow">The next chapter is yours</p>
    <h2 id="closing-title" data-split>Where <em>next?</em></h2>
    <p>A place you’ve dreamed of. A reason to get away. Let’s begin there.</p>
    <a class="btn btn--gold" href={path('journey.html')}>Plan your escape <Icon name="arrow-right" /></a>
  </div>
</section>}
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <a class="brand-link" href={path()} aria-label="Pardus Luxury Escapes home"><Brand vector light /></a>
      <p>Luxury travel, beautifully arranged. You tell us where you want to go. We arrange the rest.</p>
      <div class="footer-contact">
        <a href={`mailto:${site.bookingsEmail}`}><Icon name="mail" /><span>{site.bookingsEmail}</span></a>
        {socialLinks.map(link => <a href={link.href} rel="me noopener" target="_blank"><Icon name={link.label === 'Instagram' ? 'instagram' : 'external'} /><span>{link.label}</span></a>)}
      </div>
    </div>
    <nav class="footer-column" aria-labelledby="footer-destinations-title">
      <h2 id="footer-destinations-title">Destinations</h2>
      <div class="footer-links">
        {destinations.map(destination => <a href={path(`destination-${destination.slug}.html`)}>{destination.name}</a>)}
        <a href={path('destinations.html')}>View all <Icon name="arrow-right" /></a>
      </div>
    </nav>
    <nav class="footer-column" aria-labelledby="footer-travel-title">
      <h2 id="footer-travel-title">Ways to travel</h2>
      <div class="footer-links">
        <a href={path('journeys.html')}>Journey concepts</a>
        <a href={path('cruises.html')}>Private boat &amp; yacht cruises</a>
        <a href={path('concierge.html')}>What we arrange</a>
        <a href={path('corporate.html')}>Business travel</a>
        <a href={path('journey.html')}>Plan your escape</a>
      </div>
    </nav>
    <nav class="footer-column" aria-labelledby="footer-pardus-title">
      <h2 id="footer-pardus-title">Pardus</h2>
      <div class="footer-links">
        <a href={path('about.html')}>Why Pardus</a>
        <a href={path('journal.html')}>Journal</a>
        <a href={path('travel-desk.html')}>Travel desk</a>
        <a href={path('concept-note.html')}>Concept note</a>
        <a href={path('contact.html')}>Contact</a>
      </div>
    </nav>
  </div>
  <div class="footer-mark" aria-hidden="true"><Brand light mark /></div>
  <div class="wrap footer-base">
    <div><span>© {new Date().getFullYear()} Pardus Luxury Escapes</span><span class="footer-credit"><img src={path('brand/97-design-logo.png')} alt="" width="18" height="18" loading="lazy" decoding="async" />Made by 97 Design</span></div>
    <div><a href={path('privacy.html')}>Privacy</a><a href={path('terms.html')}>Website terms</a><a class="back-top" href="#top"><Icon name="arrow-down" /><span>Back to top</span></a></div>
  </div>
</footer>
