---
import { path } from '../data/site';
interface Props { hero?: boolean; }
const {hero = false} = Astro.props;
// Only the two families in use are requested. The display italic is critical on the home hero.
const faces = [
  {family:'Manrope',file:'Manrope-Latin-Variable.woff2',style:'normal',preload:true},
  {family:'Newsreader',file:'Newsreader-Latin-Variable.woff2',style:'normal',preload:true},
  {family:'Newsreader',file:'Newsreader-Latin-Italic-Variable.woff2',style:'italic',preload:hero},
];
const css = faces.map(face => `@font-face{font-family:'${face.family}';src:url('${path('fonts/'+face.file)}') format('woff2');font-style:${face.style};font-weight:200 800;font-display:swap;unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}`).join('\n');
---
{faces.filter(face => face.preload).map(face => <link rel="preload" href={path('fonts/'+face.file)} as="font" type="font/woff2" crossorigin="anonymous" />)}
<style is:inline set:html={css} />
