---
import { path } from '../data/site';
import { travelPhotographs } from '../data/travel-photographs.ts';
import { ownerPhotographs } from '../data/owner-photographs';
import desktopCoast from '../data/desktop-coast.json';
interface Props { name: string; alt: string; class?: string; eager?: boolean; sizes?: string; }
const { name, alt, class: className, eager = false, sizes = '(max-width: 760px) 100vw, 60vw' } = Astro.props;
// V38 photographs are published at their native 16:10 shape with only the widths the master supports, and carry a focal point
// so every container crop keeps the main subject. Every older picture keeps the 640/1280/1920 set and 3:2 shape.
const prepared = travelPhotographs.find(entry => entry.asset === name) || ownerPhotographs.find(entry => entry.asset === name);
const widths = prepared ? prepared.widths : [640, 1280, 1920];
const srcWidth = prepared ? (widths.includes(1280) ? 1280 : widths[widths.length - 1]) : 1280;
const srcHeight = prepared ? Math.round(srcWidth * prepared.height / prepared.width) : 853;
const srcset = (ext: string) => widths.map(width => `${path(`images/${name}-${width}.${ext}`)} ${width}w`).join(', ');
// Zanzibar uses the same approved coastal image on every device. Only resolution varies.
const desktop = name === 'zanzibar-v24' ? desktopCoast[1] : null;
const desktopSet = (ext: string) => desktop?.widths.map(width => `${path(`images/${desktop.prefix}-${width}.${ext}`)} ${width}w`).join(', ');
---
<picture class={className}>
  {desktop && <>
    <source type="image/avif" srcset={desktopSet('avif')} sizes={sizes} />
    <source type="image/webp" srcset={desktopSet('webp')} sizes={sizes} />
  </>}
  <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
  <source type="image/webp" srcset={srcset('webp')} sizes={sizes} />
  <img src={path(`images/${desktop ? desktop.prefix : name}-${desktop ? desktop.width : srcWidth}.webp`)} alt={desktop ? 'A palm-lined Zanzibar coast with pale sand beside the Indian Ocean. An illustrative travel scene.' : alt} width={desktop ? desktop.width : srcWidth} height={desktop ? desktop.height : srcHeight} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'low'} decoding="async" style={prepared ? `object-position:${prepared.position}` : undefined} />
</picture>
