---
import { path } from '../data/site';
import Arrow from './Arrow.astro';
---
<section class="premium-hero" aria-labelledby="hero-title" data-premium-hero>
  <div class="premium-hero-media" data-premium-depth><picture>
    <source media="(max-width: 760px)" type="image/avif" srcset={`${path('images/hero-v29-mobile-640.avif')} 640w, ${path('images/hero-v29-mobile-1024.avif')} 1024w`} sizes="100vw" />
    <source media="(max-width: 760px)" type="image/webp" srcset={`${path('images/hero-v29-mobile-640.webp')} 640w, ${path('images/hero-v29-mobile-1024.webp')} 1024w`} sizes="100vw" />
    <source type="image/avif" srcset={`${path('images/hero-v29-desktop-960.avif')} 960w, ${path('images/hero-v29-desktop-1600.avif')} 1600w, ${path('images/hero-v29-desktop-2400.avif')} 2400w`} sizes="100vw" />
    <img src={path('images/hero-v29-desktop-1600.webp')} srcset={`${path('images/hero-v29-desktop-960.webp')} 960w, ${path('images/hero-v29-desktop-1600.webp')} 1600w, ${path('images/hero-v29-desktop-2400.webp')} 2400w`} sizes="100vw" width="2400" height="1600" alt="An imagined sunlit Indian Ocean coastline, with granite, palms and villas above a turquoise lagoon" fetchpriority="high" loading="eager" decoding="async" />
  </picture></div>
  <div class="premium-hero-fade" aria-hidden="true"></div>
  <div class="premium-hero-copy"><h1 id="hero-title" data-premium-lines><span>Luxury travel,</span><span>beautifully</span><span><em>arranged.</em></span></h1><p>Flights, exceptional stays, private transfers and unforgettable experiences—planned around you.</p><div class="premium-actions"><a class="premium-button" href="#destinations">Explore destinations <Arrow /></a><a class="premium-button premium-button-outline" href="#enquire">Plan your escape <Arrow /></a></div></div>
  <div class="premium-leopard-track" aria-hidden="true"><div data-premium-leopard><img src={path('images/leopard-walk-v23.webp')} width="6144" height="256" alt="" decoding="async" /></div></div>
  <div class="premium-hero-base"><span>Maldives · Seychelles · Dubai</span><span class="premium-hero-rule" aria-hidden="true"></span><a href="#destinations">Scroll to discover <Arrow direction="down" /></a></div>
  <button class="premium-motion-toggle" data-premium-motion type="button" hidden aria-pressed="false" aria-label="Pause animation"><span data-premium-motion-label>Pause motion</span><svg class="motion-pause-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3v10M11 3v10" stroke="currentColor" stroke-width="1.5" /></svg><svg class="motion-play-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3l8 5-8 5z" fill="currentColor" /></svg></button>
</section>
