---
import Picture from './Picture.astro';
import OfferPrice from './OfferPrice.astro';
import Arrow from './Arrow.astro';
import { path } from '../data/site';
import { destinationFor, type EscapeOffer } from '../data/offers';
interface Props { offer: EscapeOffer; }
const { offer } = Astro.props;
const destination = destinationFor(offer.slug);
---
<article class="signature-escape">
  <a class="signature-image" href={path(`destination-${offer.slug}.html`)} aria-label={`Explore ${offer.label}`} data-premium-reveal="media"><Picture name={destination.image} alt={destination.alt} sizes="(max-width: 760px) 100vw, 50vw" /></a>
  <div class="signature-details"><div class="signature-title"><h3><a href={path(`destination-${offer.slug}.html`)}>{offer.label}</a></h3><span class="premium-label">{offer.nights}</span></div><OfferPrice offer={offer} /><p class="signature-description">{offer.experience}</p></div>
  <ul class="signature-inclusions" aria-label={`${offer.label} inclusions`}>{offer.inclusions.map(item => <li>{item}</li>)}</ul>
  <div class="signature-links"><a class="premium-link" href={path(`destination-${offer.slug}.html`)}>Explore the escape <Arrow /></a><a href={`${path('journey.html')}?destination=${encodeURIComponent(destination.name)}`} aria-label={`Enquire about ${offer.label}`}>Enquire <Arrow /></a></div>
</article>
