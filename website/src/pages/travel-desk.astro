---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import TravelDesk from '../components/TravelDesk.astro';
---
<Layout label="Travel desk" title="Pardus travel desk" description="Dated official travel and aviation updates, Dubai seasonal experiences and airline news, with links to the original notices." class="inner" simpleFooter>
  <PageHero eyebrow="Pardus travel desk" compact>
    <Fragment slot="title">Travel with <em>a clearer picture.</em></Fragment>
    <p class="lead">Useful destination and aviation updates, direct from official sources. Check what has changed before planning your journey.</p>
  </PageHero>
  <section class="sec sec--lagoon" aria-label="Travel updates">
    <div class="wrap">
      <h2 class="visually-hidden">Latest updates</h2>
      <TravelDesk limit={8} />
      <div class="travel-source-links"><a class="link" href="https://www.visitdubai.com/en/festivals-and-events/dubai-events-calendar" target="_blank" rel="noopener noreferrer">Dubai events calendar</a><a class="link" href="https://www.emirates.com/media-centre/" target="_blank" rel="noopener noreferrer">Emirates airline news</a><a class="link" href="https://caa.go.ug/" target="_blank" rel="noopener noreferrer">Uganda aviation updates</a></div>
    </div>
  </section>
</Layout>
