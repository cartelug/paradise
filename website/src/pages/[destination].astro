---
import Layout from '../layouts/Layout.astro';
import Picture from '../components/Picture.astro';
import SimpleEnquiry from '../components/SimpleEnquiry.astro';
import { destinations } from '../data/destinations';
import { offerFor, priceText } from '../data/offers';
import { path, absolute } from '../data/site';
export function getStaticPaths() { return destinations.map(destination => ({params:{destination:'destination-'+destination.slug},props:{destination}})); }
const { destination: d } = Astro.props;
const offer = offerFor(d.slug);
const ideas: Record<string,{title:string;text:string}[]> = {
  maldives:[{title:'Your island stay',text:'An overwater villa or a beach retreat. We help you choose a resort and room around your budget and the occasion.'},{title:'Days on the lagoon',text:'Add snorkelling, watersports or an island excursion. Choose as much activity or quiet time as you like.'},{title:'A sunset on the water',text:'Make a private boat cruise part of your honeymoon, anniversary or a beautiful evening away.'}],
  seychelles:[{title:'A beautiful beach base',text:'Choose a beachfront resort or a quieter island stay, with time for the coast and nature.'},{title:'Island-hopping',text:'Combine Mahé, Praslin or La Digue, with transfers arranged around a comfortable travel pace.'},{title:'Private boat days',text:'Add an island excursion, a snorkelling trip or a sunset cruise to your itinerary.'}],
  dubai:[{title:'Hotels, shopping & dining',text:'A luxury city hotel or a beach stay, with time for shopping, restaurants and the attractions you want to see.'},{title:'Desert experiences',text:'Trade the skyline for the dunes with a desert excursion and an evening dinner arrangement.'},{title:'Your private yacht',text:'A skyline cruise, sunset celebration or a private boat experience for your family, partner or group.'}],
  africa:[{title:'Safari stays',text:'Choose lodges and camps across Uganda, Kenya or Tanzania, matched to your route and preferred comfort.'},{title:'Private guided experiences',text:'Build your journey around game drives, landscapes and the interests of the people travelling.'},{title:'Safari & beach',text:'Pair time in the wild with a Zanzibar beach stay or another Indian Ocean escape.'}],
  zanzibar:[{title:'Safari first',text:'Begin with a Kenya or Tanzania safari. We arrange the route, lodges and onward connections.'},{title:'The Zanzibar coast',text:'Finish on the beach with a comfortable resort, private transfers and time to enjoy the island.'},{title:'Dhow cruises & culture',text:'Add Stone Town, a spice visit or a sunset dhow cruise. A Zanzibar-only holiday is also available to plan.'}],
  europe:[{title:'Beautiful city stays',text:'Start with the city you want to see and a hotel placed for the sights, restaurants and neighbourhoods you enjoy.'},{title:'Private tours & experiences',text:'Discover culture, food and landmarks with guided experiences and enough space to explore at your own pace.'},{title:'A Mediterranean finish',text:'Add an island, a coastline or a second city, with flights, rail or transfers brought into one itinerary.'}],
};
const schema = {'@context':'https://schema.org','@type':'TouristDestination',name:d.name,description:offer.experience,url:absolute('destination-'+d.slug+'.html')};
---
<Layout title={offer.label} description={offer.experience} image={'images/'+d.image+'-1920.webp'} class="escape-inner" simpleFooter>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <section class="escape-detail-hero"><Picture name={d.image} alt={d.alt} eager sizes="100vw" /><div class="escape-detail-heading"><p class="eyebrow">{d.country} · {offer.nights}</p><h1>{offer.label}</h1><p>{offer.experience}</p><div class="escape-detail-offer"><div><strong>{priceText(offer)}</strong><small>{offer.fromUSD === null ? 'Tailored to your dates, travellers and chosen stay' : offer.priceBasis+' · subject to availability'}</small></div><a class="escape-button" href={path('journey.html')+'?destination='+encodeURIComponent(d.name)}>Enquire about this escape</a></div></div></section>
  <section class="escape-overview escape-section"><div><p class="eyebrow">Your journey, clearly arranged</p><h2>See yourself here.<br /><em>Leave the planning to us.</em></h2></div><div><p>{offer.experience} Tell us your dates and the kind of stay you have in mind, and we’ll prepare a proposal around you.</p><h3>What your proposal can include</h3><ul><li>Flights from your departure city</li><li>Selected hotels, resorts or safari stays</li><li>Airport and destination transfers</li><li>Private tours, activities and boat experiences</li><li>Visa guidance and a custom itinerary</li></ul><p class="escape-detail-note">The exact inclusions, USD price and supplier terms are confirmed in your proposal before booking.</p></div></section>
  <section class="escape-possibilities escape-section"><p class="eyebrow">What you can do</p><h2>A stay worth<br /><em>looking forward to.</em></h2><div class="escape-experience-grid">{ideas[d.slug].map(idea => <div data-reveal><h3>{idea.title}</h3><p>{idea.text}</p></div>)}</div>
    {d.slug === 'dubai' && <p class="escape-detail-note">Planning around an event? <a class="escape-underlined" href="https://www.visitdubai.com/articles/events-to-look-forward-to-this-season" target="_blank" rel="noopener noreferrer">See the current winter calendar at Visit Dubai</a></p>}
  </section>
  <section class="escape-section escape-overview"><div><p class="eyebrow">A few practical details</p><h2>Your dates.<br /><em>Your way to travel.</em></h2></div><div><h3>Suggested stay</h3><p>{offer.nights}. Add or reduce nights to suit your plans.</p><h3>Before you decide</h3><p>{d.seasonNote}</p><a class="escape-underlined" href={path('cruises.html')}>Explore private boat & yacht experiences</a></div></section>
  <section class="escape-enquiry-section escape-section" id="enquire"><div class="escape-enquiry-intro"><p class="eyebrow">Make it your escape</p><h2>Plan your<br /><em>{offer.label.replace('Safari & ','')} journey.</em></h2><p>Tell us your dates and budget. We’ll take care of the next steps.</p></div><SimpleEnquiry id={'enquiry-'+d.slug} defaultDestination={d.name} /></section>
</Layout>
