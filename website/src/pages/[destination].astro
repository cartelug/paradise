---
import Layout from '../layouts/Layout.astro';
import Picture from '../components/Picture.astro';
import Arrow from '../components/Arrow.astro';
import { destinations } from '../data/destinations';
import { path } from '../data/site';
export function getStaticPaths() { return destinations.map((destination, i) => ({ params: { destination: `destination-${destination.slug}` }, props: { destination, next: destinations[(i + 1) % destinations.length] } })); }
const { destination: d, next } = Astro.props;
const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'The collection', item: new URL(path('destinations.html'), 'https://cartelug.github.io').toString() },
    { '@type': 'ListItem', position: 2, name: d.name, item: new URL(path(`destination-${d.slug}.html`), 'https://cartelug.github.io').toString() },
  ],
};
const destinationSchema = {
  '@context': 'https://schema.org', '@type': 'TouristDestination', name: d.name,
  description: d.description, touristType: d.idealFor,
  url: new URL(path(`destination-${d.slug}.html`), 'https://cartelug.github.io').toString(),
};
---
<Layout title={d.name} description={d.description} image={`images/${d.image}-1920.webp`}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify([breadcrumbSchema, destinationSchema])} />
  <section class="destination-detail-hero"><Picture name={d.image} alt={d.alt} eager sizes="100vw" /><div class="destination-detail-title"><p class="eyebrow">The collection / {d.country}</p><h1>{d.name}</h1><p>{d.subtitle}</p></div></section>
  <section class="destination-essay section-wrap"><div><nav class="breadcrumb" aria-label="Breadcrumb"><a href={path('destinations.html')}>The collection</a><span aria-hidden="true">/</span><span>{d.name}</span></nav><p class="eyebrow">{d.mood}</p><h2 data-reveal>{d.intro}</h2></div><div class="essay-copy">{d.paragraphs.map(p => <p data-reveal>{p}</p>)}<div class="destination-detail-actions"><a class="text-button" href={`${path('journey.html')}?destination=${encodeURIComponent(d.name)}&place=${d.place}&pace=${d.pace}`} data-reveal>Plan my {d.name.replace('The ', '')} journey <Arrow /></a><button type="button" class="folio-save requires-js" data-folio-save={d.slug} data-folio-type="destination" data-folio-label={d.name} aria-pressed="false"><span data-save-label>Save to your Folio</span><span aria-hidden="true">+</span></button></div></div></section>
  <section class="destination-facts section-wrap" aria-label={`${d.name} planning notes`}>
    <div><p class="eyebrow">At a glance</p><dl><div><dt>Suggested stay</dt><dd>{d.suggestedStay}</dd></div><div><dt>Natural pace</dt><dd>{d.pace}</dd></div><div><dt>Best suited to</dt><dd>{d.idealFor.join(' · ')}</dd></div></dl></div>
    <div><p class="eyebrow">Seasonal rhythm</p><p>{d.seasonNote}</p></div>
  </section>
  <section class="detail-highlights section-wrap"><p class="eyebrow">The possibilities</p><h2 data-reveal>{d.title}</h2><ol class="process-list">{d.highlights.map((h, i) => <li data-reveal><span>0{i + 1}</span><div><h3>{h.name}</h3><p>{h.text}</p></div></li>)}</ol><p class="detail-note">An invitation to explore, not a fixed package. Accommodation, experiences and arrangements are tailored to your brief and confirmed separately, subject to availability.</p></section>
  <section class="destination-planning section-wrap"><div><p class="eyebrow">Pairs naturally with</p><h2>A route with<br /><em>reason.</em></h2></div><div class="planning-lists"><div><h3>Possible pairings</h3><ul>{d.routePairs.map(item => <li>{item}</li>)}</ul></div><div><h3>Decisions that matter</h3><ul>{d.considerations.map(item => <li>{item}</li>)}</ul></div></div></section>
  <section class="next-destination"><div><p class="eyebrow">Keep exploring</p><h2>{next.name}</h2></div><a class="text-button" href={path(`destination-${next.slug}.html`)}>Next destination <Arrow /></a></section>
</Layout>
