---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Picture from '../components/Picture.astro';
import Icon from '../components/Icon.astro';
import { journal } from '../data/journal';
import { path, absolute } from '../data/site';
import { largestImage } from '../data/photography.ts';
export function getStaticPaths() { return journal.map((entry, i) => ({ params: { journal: `journal-${entry.slug}` }, props: { entry, next: journal[(i + 1) % journal.length] } })); }
const { entry, next } = Astro.props;
const readMinutes = Math.max(1, Math.ceil([entry.intro, ...entry.paragraphs].join(' ').split(/\s+/).length / 200));
const displayDate = (value: string) => new Intl.DateTimeFormat('en', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${value}T00:00:00Z`));
const articleUrl = absolute(`journal-${entry.slug}.html`);
const articleSchema = {
  '@context': 'https://schema.org', '@type': 'Article', headline: entry.title,
  description: entry.description, datePublished: entry.publishedAt, dateModified: entry.updatedAt,
  author: { '@type': 'Organization', name: entry.author }, publisher: { '@type': 'Organization', name: 'Pardus Luxury Escapes' },
  image: absolute(largestImage(entry.image)), mainEntityOfPage: articleUrl,
};
---
<Layout label="The Journal" title={entry.title} class="inner article-page" description={entry.description} image={largestImage(entry.image)}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <PageHero image={entry.image} alt={entry.alt} eyebrow={`${entry.category}, ${readMinutes} min read`}>
    <nav slot="breadcrumb" class="breadcrumb" aria-label="Breadcrumb"><a href={path('journal.html')}><Icon name="arrow-left" /> The Journal</a></nav>
    <Fragment slot="title">{entry.title}</Fragment>
    <p class="lead">{entry.subtitle}</p>
    <p class="small" style="margin-top:18px">By {entry.author}. Published <time datetime={entry.publishedAt}>{displayDate(entry.publishedAt)}</time>. Updated <time datetime={entry.updatedAt}>{displayDate(entry.updatedAt)}</time>.</p>
  </PageHero>
  <section class="sec sec--ivory blend-top" style="--blend:#050c1a" aria-label="Article">
    <div class="wrap article-layout">
      <div class="article-margin"><p class="eyebrow">A Pardus perspective</p><p>Thoughtful notes for a personal journey.</p><a class="link" href={path('journal.html')}>Explore all stories <Icon name="arrow-right" /></a>{entry.relatedDestination && <a class="link" href={path(`destination-${entry.relatedDestination}.html`)}>Explore the destination <Icon name="arrow-right" /></a>}</div>
      <article class="article-body">
        <h2 data-reveal>{entry.intro}</h2>
        {entry.paragraphs.map(p => <p data-reveal>{p}</p>)}
        <p data-reveal><a class="btn btn--ink" href={path('journey.html')}>Begin your journey <Icon name="arrow-right" /></a></p>
      </article>
    </div>
  </section>
  <section class="sec sec--sand" aria-label="Keep reading">
    <div class="wrap article-next">
      <a class="frame" href={path(`journal-${next.slug}.html`)} aria-label={`Read ${next.title}`} data-reveal="clip"><Picture name={next.image} alt={next.alt} sizes="(max-width: 900px) 100vw, 50vw" /></a>
      <div data-reveal><p class="eyebrow">Keep reading</p><h2>{next.title}</h2><a class="btn btn--ink" href={path(`journal-${next.slug}.html`)}>Next in the journal <Icon name="arrow-right" /></a></div>
    </div>
  </section>
</Layout>
