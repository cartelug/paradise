---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { journeys } from '../data/journeys';
import { path, absolute } from '../data/site';
import { largestImage } from '../data/photography.ts';

export function getStaticPaths() {
  return journeys.map((journey, index) => ({
    params: { experience: `journey-${journey.slug}` },
    props: { journey, next: journeys[(index + 1) % journeys.length] },
  }));
}

const { journey, next } = Astro.props;
const canonical = absolute(`journey-${journey.slug}.html`);
const schemas = [
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Journeys', item: absolute('journeys.html') },
      { '@type': 'ListItem', position: 2, name: journey.name, item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org', '@type': 'TouristTrip', name: journey.name,
    description: journey.description, touristType: journey.idealFor,
    itinerary: journey.destinations.join(' and '), url: canonical,
  },
];
---
<Layout label={journey.name} title={journey.name} description={journey.description} image={largestImage(journey.image)} class="inner journey-detail-page">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemas)} />
  <PageHero image={journey.image} alt={journey.alt} eyebrow={journey.eyebrow}>
    <nav slot="breadcrumb" class="breadcrumb" aria-label="Breadcrumb"><a href={path('journeys.html')}>Journeys</a><Icon name="chevron-right" /><span>{journey.name}</span></nav>
    <Fragment slot="title">{journey.name}</Fragment>
    <p class="lead">{journey.title}</p>
  </PageHero>

  <section class="sec sec--ivory blend-top" style="--blend:#050c1a" aria-labelledby="overview-title">
    <div class="wrap split">
      <div><p class="eyebrow" data-reveal>A possible rhythm</p><h2 id="overview-title" data-split>{journey.title}</h2></div>
      <div data-reveal>
        <p class="prose">{journey.description}</p>
        <dl class="overview-list"><div><dt>Suggested length</dt><dd>{journey.duration.split(' / ')[1]}</dd></div><div><dt>Setting</dt><dd>{journey.place}</dd></div><div><dt>Pace</dt><dd>{journey.pace}</dd></div><div><dt>Reason</dt><dd>{journey.reason}</dd></div></dl>
        <button type="button" class="folio-save requires-js" data-folio-save={journey.slug} data-folio-type="journey" data-folio-label={journey.name} aria-pressed="false"><Icon name="bookmark" /><span data-save-label>Save this journey</span></button>
      </div>
    </div>
  </section>

  <section class="sec sec--night blend-top" style="--blend:#f1e9d9" aria-labelledby="rhythm-title">
    <div class="wrap">
      <p class="eyebrow" data-reveal>The shape, before the schedule</p>
      <h2 id="rhythm-title" data-split>Three acts. <em>Room to adapt.</em></h2>
      <ol class="acts" style="margin-top:clamp(28px,4vw,56px)" data-stagger="120">{journey.chapters.map((chapter, index) => <li data-reveal><span class="num">0{index + 1}</span><div><h3>{chapter.title}</h3><p>{chapter.text}</p></div></li>)}</ol>
    </div>
  </section>

  <section class="sec sec--lagoon sec--tight" aria-label="Practical details">
    <div class="wrap practical" style="margin-top:0" data-stagger="120">
      <div data-reveal><h3>Who it may suit</h3><ul class="ticks">{journey.idealFor.map(item => <li><Icon name="check" /><span>{item}</span></li>)}</ul></div>
      <div data-reveal><h3>The working rhythm</h3><ul class="ticks">{journey.rhythm.map(item => <li><Icon name="check" /><span>{item}</span></li>)}</ul></div>
      <div data-reveal><h3>What can change</h3><ul class="ticks">{journey.flexibility.map(item => <li><Icon name="check" /><span>{item}</span></li>)}</ul></div>
    </div>
  </section>

  <section class="sec sec--dusk" aria-labelledby="shape-title">
    <div class="wrap statement">
      <h2 id="shape-title" data-split>Make it <em>yours.</em></h2>
      <p data-reveal>This is an editorial journey concept, not a package or availability promise. The route, accommodation, transfers, experiences, timing and price are discussed and confirmed around your brief.</p>
      <div class="actions" data-reveal><a class="btn btn--gold" href={`${path('journey.html')}?style=${encodeURIComponent(journey.name)}&place=${journey.place}&pace=${journey.pace}&reason=${journey.reason}`}>Shape this journey <Icon name="arrow-right" /></a><a class="btn btn--ghost" href={path(`journey-${next.slug}.html`)}>Next: {next.name} <Icon name="arrow-right" /></a></div>
    </div>
  </section>
</Layout>
