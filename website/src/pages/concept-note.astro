---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import EscapeCard from '../components/EscapeCard.astro';
import Icon from '../components/Icon.astro';
import { offers, services, cruiseTypes, priceNote, priceText } from '../data/offers';
import { serviceIcons } from '../data/icons';
import { path } from '../data/site';
const cruiseIcons = ['yacht', 'heart', 'compass', 'sparkle'] as const;
---
<Layout label="Concept note" title="The Pardus concept note" description="A clear guide to Pardus Luxury Escapes destinations, private cruises, travel services and how to enquire." class="inner" simpleFooter>
  <PageHero eyebrow="Pardus Luxury Escapes, October 2026">
    <Fragment slot="title">Extraordinary journeys. <em>Personally curated.</em></Fragment>
    <p class="lead">You tell us where you want to go. We arrange the flights, stays, transfers and experiences. Every journey begins with your dates, your budget and the people travelling.</p>
    <div class="actions"><a class="btn btn--gold" href={path('documents/PARDUS_Luxury_Escapes_Concept_Note.pdf')} download><Icon name="download" /> Download the concept note</a></div>
  </PageHero>
  <section class="sec sec--ivory blend-top" style="--blend:#050c1a" aria-label="Signature escapes">
    <div class="wrap">
      <h2 class="visually-hidden">Signature escapes</h2>
      <div class="card-grid card-grid--2" data-stagger="110">{offers.slice(0, 2).map(offer => <EscapeCard offer={offer} featured />)}</div>
      <p class="price-note">{priceNote}</p>
    </div>
  </section>
  <section class="sec sec--sand" aria-labelledby="more-title">
    <div class="wrap">
      <h2 id="more-title" data-split>More ways <em>to get away.</em></h2>
      <div class="card-grid" style="margin-top:clamp(28px,4vw,56px)" data-stagger="90">{offers.slice(2).map(offer => <EscapeCard offer={offer} />)}</div>
    </div>
  </section>
  <section class="sec sec--ivory" aria-labelledby="services-title">
    <div class="wrap">
      <p class="eyebrow" data-reveal>A complete service</p>
      <h2 id="services-title" data-split>You choose where. <em>We arrange the rest.</em></h2>
      <ul class="tiles" style="margin-top:clamp(28px,4vw,56px)" data-stagger="60">{services.map(service => <li class="tile" data-reveal><span class="badge"><Icon name={serviceIcons[service] || 'sparkle'} /></span><strong>{service}</strong></li>)}</ul>
    </div>
  </section>
  <section class="sec sec--sand" aria-labelledby="cruise-title">
    <div class="wrap">
      <p class="eyebrow" data-reveal>Private boat &amp; yacht experiences</p>
      <h2 id="cruise-title" data-split>Beautiful moments. <em>Out on the water.</em></h2>
      <div class="exp-grid exp-grid--2" data-stagger="110">{cruiseTypes.map((type, i) => <article class="exp" data-reveal><span class="badge"><Icon name={cruiseIcons[i]} /></span><h3>{type.title}</h3><p>{type.text}</p><div class="exp-price"><strong>{priceText(type)}</strong><small>{type.basis}</small></div></article>)}</div>
      <p class="note">Cruises are quoted in USD for your destination, group size, duration and occasion. Your proposal confirms the boat, route and inclusions.</p>
    </div>
  </section>
  <section class="sec sec--dusk" aria-labelledby="note-cta-title">
    <div class="wrap statement">
      <h2 id="note-cta-title" data-split>Tell us where. <em>We’ll take it from here.</em></h2>
      <p data-reveal>Share the destination, travel dates, number of travellers and budget. Review a clear itinerary and USD proposal. Confirm when the arrangements feel right.</p>
      <a class="btn btn--gold" href={path('journey.html')} data-reveal>Plan your escape <Icon name="arrow-right" /></a>
    </div>
  </section>
</Layout>
