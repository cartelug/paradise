---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import EscapeCard from '../components/EscapeCard.astro';
import { offers, priceNote } from '../data/offers';
---
<Layout label="Destinations" title="Luxury holiday destinations" description="Luxury holidays in the Maldives, Seychelles, Dubai, Zanzibar, East Africa and Europe, with suggested stays, safaris and a clear starting price. Quoted in UGX for travellers in Uganda and East Africa." class="inner" simpleFooter>
  <PageHero eyebrow="The Pardus destinations">
    <Fragment slot="title">Choose your place. <em>We’ll plan your escape.</em></Fragment>
    <p class="lead">Islands, cities, safari country and the coast. Explore your stay, see what is included, and let us tailor the journey around you.</p>
  </PageHero>
  <section class="sec sec--ivory blend-top" style="--blend:#050c1a" aria-label="Destinations">
    <div class="wrap">
      <h2 class="visually-hidden">All destinations</h2>
      <div class="collection-bar">
        <div class="pills" role="group" aria-label="Filter destinations"><button class="pill" data-filter="all" aria-pressed="true">All destinations</button><button class="pill" data-filter="islands" aria-pressed="false">Islands &amp; beaches</button><button class="pill" data-filter="wild" aria-pressed="false">Safaris</button><button class="pill" data-filter="culture" aria-pressed="false">City &amp; culture</button></div>
        <p data-collection-count aria-live="polite">{offers.length} destinations to explore</p>
      </div>
      <div class="card-grid" data-stagger="90">{offers.map(offer => <EscapeCard offer={offer} />)}</div>
      <p class="price-note">{priceNote}</p>
    </div>
  </section>
</Layout>
