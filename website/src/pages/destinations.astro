---
import Layout from '../layouts/Layout.astro';
import Picture from '../components/Picture.astro';
import Arrow from '../components/Arrow.astro';
import { destinations } from '../data/destinations';
import { path } from '../data/site';
---
<Layout title="The destination collection" description="Explore personally planned journeys across the Maldives, Zanzibar, East Africa, the Seychelles and beyond.">
  <section class="page-intro"><p class="eyebrow">The Pardus collection</p><div class="page-intro-row"><h1>A world<br />worth <em>knowing.</em></h1><p>Some places stay with you.<br />Explore a few of ours, then make the journey your own.</p></div></section>
  <section class="destination-collection" aria-label="Destination collection">
    <div class="collection-filters"><div class="filter-buttons" role="group" aria-label="Filter destinations"><button data-filter="all" aria-pressed="true">All places</button><button data-filter="islands" aria-pressed="false">Island life</button><button data-filter="wild" aria-pressed="false">The wild</button><button data-filter="culture" aria-pressed="false">City & culture</button></div><p class="collection-count" data-collection-count aria-live="polite">{destinations.length} destinations to discover</p></div>
    <div class="collection-grid">{destinations.map(d => <article class="journey-card destination-card-v2" data-category={d.category} data-reveal>
      <a href={path(`destination-${d.slug}.html`)} class="journey-card-picture"><Picture name={d.image} alt={d.alt} sizes="(max-width: 760px) 100vw, 50vw" /><span class="circle-arrow"><Arrow /></span></a>
      <div class="journey-card-meta"><div><p class="eyebrow">{d.number} / {d.country}</p><h2><a href={path(`destination-${d.slug}.html`)}>{d.name}</a></h2></div><p>{d.description}</p></div>
      <ul class="destination-card-facts" aria-label={`${d.name} at a glance`}><li>{d.pace} pace</li><li>{d.suggestedStay}</li><li>{d.reasons.slice(0, 2).join(' · ')}</li></ul>
      <div class="destination-card-actions"><a class="text-button" href={path(`destination-${d.slug}.html`)}>Explore {d.name.replace('The ', '')} <Arrow /></a><button type="button" class="folio-save requires-js" data-folio-save={d.slug} data-folio-type="destination" data-folio-label={d.name} aria-pressed="false"><span data-save-label>Save to your Folio</span><span aria-hidden="true">+</span></button></div>
    </article>)}</div>
  </section>
</Layout>
