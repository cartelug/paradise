---
import Layout from '../layouts/Layout.astro';
import EscapeCard from '../components/EscapeCard.astro';
import { offers } from '../data/offers';
---
<Layout title="Destinations & escapes" description="Explore Maldives, Seychelles, Dubai, East Africa, safari and Zanzibar journeys, with suggested stays and a clear USD quote for your dates." class="escape-inner" simpleFooter>
  <section class="escape-page-intro"><p class="eyebrow">The Pardus destinations</p><h1>Choose your place.<br /><em>We’ll plan your escape.</em></h1><p>See the destination, the experience and a suggested stay. Ask for your USD quote and we’ll bring the details together.</p></section>
  <section class="escape-collection" aria-label="Destinations">
    <div class="collection-filters"><div class="filter-buttons" role="group" aria-label="Filter destinations"><button data-filter="all" aria-pressed="true">All destinations</button><button data-filter="islands" aria-pressed="false">Islands & beaches</button><button data-filter="wild" aria-pressed="false">Safaris</button><button data-filter="culture" aria-pressed="false">City & culture</button></div><p class="collection-count" data-collection-count aria-live="polite">{offers.length} destinations to explore</p></div>
    <div class="escape-collection-grid">{offers.map(offer => <EscapeCard offer={offer} />)}</div>
    <p class="escape-price-note">Stays are suggested itinerary lengths. Your final proposal confirms availability, inclusions and the total price in USD.</p>
  </section>
</Layout>
