---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Picture from '../components/Picture.astro';
import Icon from '../components/Icon.astro';
import { journeys } from '../data/journeys';
import { path } from '../data/site';
---
<Layout label="Signature journeys" title="Signature journeys" description="Explore Pardus signature journeys: safari and shore, a private island reset, family adventures, celebrations and Mediterranean escapes, each one shaped around you." class="inner">
  <PageHero eyebrow="A place to begin">
    <Fragment slot="title">Journeys with a point of <em>view.</em></Fragment>
    <p class="lead">These are possible shapes, never fixed packages. Begin with the one that feels closest, then change every part of it.</p>
  </PageHero>
  <section class="sec sec--ivory blend-top" style="--blend:#050c1a" aria-labelledby="journey-index-title" data-journey-library>
    <div class="wrap">
      <div class="collection-bar">
        <h2 id="journey-index-title" style="font-size:clamp(1.75rem,1.3rem+1.8vw,2.75rem)">Six ways into the world.</h2>
        <div class="pills requires-js" role="group" aria-label="Filter journey concepts">
          {['All', 'Escape', 'Celebration', 'Family', 'Business'].map((reason, index) => <button type="button" class="pill" data-journey-filter={reason.toLowerCase()} aria-pressed={index === 0 ? 'true' : 'false'}>{reason}</button>)}
        </div>
      </div>
      <div class="concept-grid" data-stagger="100">
        {journeys.map(journey => <article class="concept" data-journey-card data-reason={journey.reason.toLowerCase()} data-reveal>
          <a class="concept-image" href={path(`journey-${journey.slug}.html`)} aria-label={`Explore ${journey.name}`}><span class="frame"><Picture name={journey.image} alt={journey.alt} sizes="(max-width: 820px) 100vw, 50vw" /></span><span class="concept-number">{journey.number}</span></a>
          <div class="concept-body">
            <p class="eyebrow" style="margin-bottom:4px">{journey.eyebrow}</p>
            <h2><a href={path(`journey-${journey.slug}.html`)}>{journey.name}</a></h2>
            <p>{journey.description}</p>
            <div class="concept-meta"><span>{journey.pace} pace</span><span>{journey.duration.replace('Suggested rhythm / ', '').replace('Typical frame / ', '')}</span></div>
            <div class="concept-actions"><a class="link" href={path(`journey-${journey.slug}.html`)}>Explore the idea <Icon name="arrow-right" /></a><button type="button" class="folio-save requires-js" data-folio-save={journey.slug} data-folio-type="journey" data-folio-label={journey.name} aria-pressed="false"><Icon name="bookmark" /><span data-save-label>Save this journey</span></button></div>
          </div>
        </article>)}
      </div>
      <p class="empty-state" data-journey-empty hidden>No journey concepts match that reason yet. Explore all concepts or begin with an open brief.</p>
    </div>
  </section>
  <section class="sec sec--dusk" aria-labelledby="open-brief-title">
    <div class="wrap statement">
      <p class="eyebrow" data-reveal>Nothing needs to fit exactly</p>
      <h2 id="open-brief-title" data-split>Keep the feeling. <em>Change the rest.</em></h2>
      <a class="btn btn--gold" href={path('journey.html')} data-reveal>Start an open brief <Icon name="arrow-right" /></a>
    </div>
  </section>
</Layout>
