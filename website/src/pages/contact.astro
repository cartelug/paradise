---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import { site, path } from '../data/site';
---
<Layout title="Contact Pardus" simpleFooter>
  <section class="page-intro"><p class="eyebrow">Let’s begin with an idea</p><div class="page-intro-row"><h1>A place.<br />A reason.<br /><em>A conversation.</em></h1><p>Whether you are planning time away or travel for your business, a clear brief is a good place to start.</p></div></section>
  <section class="section-wrap contact-grid"><div class="contact-option"><p class="eyebrow">Personal travel</p><h2>Your next escape.</h2><p>A destination, an occasion or a little time away. Put your ideas into a personal journey brief.</p><a href={path('journey.html')} class="text-button">Plan a personal journey <Arrow /></a></div><div class="contact-option"><p class="eyebrow">Corporate travel</p><h2>Your business journey.</h2><p>Share the schedule, travellers and details that matter to your organisation.</p><a href={`${path('journey.html')}?style=Executive%20Arrivals&reason=Business`} class="text-button">Prepare a business brief <Arrow /></a></div></section>
  <section class="section-wrap">
  {site.enquiryEndpoint ? (
    <form id="contact-form" class="planner contact-form" novalidate action={site.enquiryEndpoint} method="POST">
      <input type="hidden" name="_subject" value="Pardus contact form enquiry" />
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="visually-hidden" />
      <label for="contact-name">Your name</label><input id="contact-name" name="name" required maxlength="120" autocomplete="name" />
      <label for="contact-email">Email</label><input id="contact-email" name="email" type="email" required maxlength="200" autocomplete="email" />
      <label for="contact-reason">This is about</label><select id="contact-reason" name="reason"><option>General enquiry</option><option>Personal travel</option><option>Corporate travel</option><option>Press &amp; partnerships</option></select>
      <label for="contact-message">Message</label><textarea id="contact-message" name="message" rows="5" required maxlength="1500"></textarea>
      <p class="form-error" data-error role="alert"></p>
      <div class="planner-actions"><button type="submit" class="button"><span>Send message</span><Arrow /></button></div>
      <p class="form-status" data-form-status role="status"></p>
    </form>
  ) : site.email ? (
    <p class="contact-status">Email Pardus at <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
  ) : (
    <p class="contact-status">Online enquiry delivery and verified contact details are being finalised. The journey planner currently creates a download only; it does not contact Pardus.</p>
  )}
  </section>
</Layout>
