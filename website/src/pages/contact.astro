---
import Layout from '../layouts/Layout.astro';
import { site, path, whatsappUrl } from '../data/site';
---
<Layout title="Contact Pardus" description="Contact Pardus Luxury Escapes about a holiday, booking, private yacht experience or travel support." class="escape-inner" simpleFooter>
  <section class="escape-page-intro"><p class="eyebrow">Contact Pardus</p><h1>One conversation.<br /><em>A beautiful journey.</em></h1><p>Tell us the destination and what you have in mind. We’ll bring the travel arrangements into one clear plan.</p></section>
  <section class="escape-section escape-contacts">
    <div><h2>Plan a trip</h2><p>Destinations, reservations and travel proposals.</p><a href={'mailto:'+site.bookingsEmail}>{site.bookingsEmail}</a><br /><a class="escape-underlined" href={path('journey.html')}>Prepare a travel enquiry</a></div>
    <div><h2>General enquiries</h2><p>Company information and general questions.</p><a href={'mailto:'+site.email}>{site.email}</a></div>
    <div><h2>Support & feedback</h2><p>Post-booking help, reviews and service feedback.</p><a href={'mailto:'+site.supportEmail}>{site.supportEmail}</a></div>
  </section>
  {whatsappUrl && <section class="escape-section"><a class="escape-button" href={whatsappUrl}>Message Pardus on WhatsApp</a></section>}
</Layout>
