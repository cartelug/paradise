---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import { site, path } from '../data/site';
---
<Layout title="Contact Pardus" simpleFooter>
  <section class="page-intro"><p class="eyebrow">Let’s begin with an idea</p><div class="page-intro-row"><h1>A place.<br />A reason.<br /><em>A conversation.</em></h1><p>Whether you are planning time away or travel for your business, a clear brief is a good place to start.</p></div></section>
  <section class="section-wrap contact-grid"><div class="contact-option"><p class="eyebrow">Personal travel</p><h2>Your next escape.</h2><p>A destination, an occasion or a little time away. Put your ideas into a personal journey brief.</p><a href={path('journey.html')} class="text-button">Plan a personal journey <Arrow /></a></div><div class="contact-option"><p class="eyebrow">Corporate travel</p><h2>Your business journey.</h2><p>Share the schedule, travellers and details that matter to your organisation.</p><a href={`${path('journey.html')}?style=Corporate%20travel`} class="text-button">Prepare a business brief <Arrow /></a></div>
  {site.email ? <p class="contact-status">Email Pardus at <a href={`mailto:${site.email}`}>{site.email}</a>.</p> : <p class="contact-status">Online enquiry delivery and verified contact details are being finalised. The journey planner currently creates a download only; it does not contact Pardus.</p>}
  </section>
</Layout>
