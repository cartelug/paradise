---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { path } from '../data/site';
---
<Layout title="A different direction" description="This page isn’t here. Explore Pardus destinations, journey ideas and the Journal to find your next escape." class="inner" simpleFooter>
  <section class="lost sec--night" style="position:relative;isolation:isolate;overflow:hidden">
    <div class="page-hero-globe" aria-hidden="true"><svg viewBox="0 0 800 800" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="400" cy="400" r="326"/><ellipse cx="400" cy="400" rx="225" ry="326"/><ellipse cx="400" cy="400" rx="110" ry="326"/><ellipse cx="400" cy="400" rx="326" ry="215"/><ellipse cx="400" cy="400" rx="326" ry="100"/><path d="M74 400H726M400 74V726"/></svg></div>
    <div class="wrap">
      <p class="eyebrow">404, a turn in the journey</p>
      <h1>A different <em>direction.</em></h1>
      <p class="lead">This page isn’t here. Your next escape could be.</p>
      <div class="actions"><a class="btn btn--gold" href={path('destinations.html')}>Return to the collection <Icon name="arrow-right" /></a><a class="btn btn--ghost" href={path()}>Back to the homepage</a></div>
    </div>
  </section>
</Layout>
