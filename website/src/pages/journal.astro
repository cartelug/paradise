---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Picture from '../components/Picture.astro';
import Icon from '../components/Icon.astro';
import { journal } from '../data/journal';
import { path } from '../data/site';
const featured = journal[1];
const readingTime = (entry: typeof featured) => Math.max(1, Math.ceil([entry.intro, ...entry.paragraphs].join(' ').split(/\s+/).length / 200));
const ordered = [journal[3], journal[2], journal[0], journal[4], featured];
const displayDate = (value: string) => new Intl.DateTimeFormat('en', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${value}T00:00:00Z`));
---
<Layout title="The Pardus journal" class="inner journal-page" description="Destination notes and considered advice for a more personal way to travel.">
  <PageHero eyebrow="The Journal" compact>
    <Fragment slot="title">Places worth knowing. <em>Details worth considering.</em></Fragment>
  </PageHero>
  <section class="sec sec--ivory blend-top" style="--blend:#050c1a" aria-labelledby="cover-title">
    <div class="wrap cover">
      <a class="cover-image" href={path(`journal-${featured.slug}.html`)} aria-label={`Read ${featured.title}`} data-reveal="clip"><span class="frame" style="height:100%" data-parallax="0.05"><Picture name={featured.image} alt={featured.alt} eager sizes="(max-width: 860px) 100vw, 60vw" /></span></a>
      <div class="cover-copy" data-stagger="110">
        <p class="eyebrow" data-reveal>In focus: {readingTime(featured)} min read</p>
        <h2 id="cover-title" data-reveal>One ocean. <em>Your own island.</em></h2>
        <p data-reveal>{featured.description}</p>
        <p class="byline" data-reveal>By {featured.author}, {displayDate(featured.publishedAt)}</p>
        <a class="btn btn--ink" href={path(`journal-${featured.slug}.html`)} data-reveal>Read the island guide <Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>
  <section class="sec sec--sand" aria-labelledby="library-title" data-journal>
    <div class="wrap">
      <div class="library-head"><div><p class="eyebrow">Ideas to take with you</p><h2 id="library-title">The reading room</h2></div><label class="search requires-js">Find a story<input type="search" data-journal-search placeholder="Try safari, islands, planning…" /></label></div>
      <div class="journal-controls requires-js"><div class="pills" role="group" aria-label="Filter journal by topic">{['All stories', 'Destination notes', 'Process', 'Before you book'].map((topic, i) => <button type="button" class="pill" data-journal-topic={i === 0 ? 'all' : topic} aria-pressed={i === 0 ? 'true' : 'false'}>{topic}</button>)}</div><p data-journal-count role="status">{journal.length} stories</p></div>
      <div class="stories" data-stagger="90">{ordered.map(entry => <article class="story" data-story data-topic={entry.category} data-search={`${entry.title} ${entry.description} ${entry.category} ${entry.author}`.toLowerCase()} data-reveal><a href={path(`journal-${entry.slug}.html`)}><span class="frame"><Picture name={entry.image} alt={entry.alt} sizes="(max-width: 640px) 100vw, (max-width: 980px) 50vw, 33vw" /></span><div class="story-meta"><span>{entry.category}</span><span>{readingTime(entry)} min read</span></div><h3>{entry.title}</h3><p>{entry.description}</p><p class="byline">{entry.author}, {displayDate(entry.publishedAt)}</p></a></article>)}</div>
      <div class="journal-empty" data-journal-empty hidden><p>No stories match that search.</p><button type="button" class="btn btn--ink btn--sm" data-journal-reset>Clear search and topics</button></div>
    </div>
  </section>
  <section class="sec sec--dusk" aria-labelledby="journal-cta-title">
    <div class="wrap statement">
      <p class="eyebrow" data-reveal>The Pardus perspective</p>
      <h2 id="journal-cta-title" data-split>Good travel starts with <em>better questions.</em></h2>
      <a class="btn btn--gold" href={path('journey.html')} data-reveal>Put your ideas into a journey <Icon name="arrow-right" /></a>
    </div>
  </section>
</Layout>
