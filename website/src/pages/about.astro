---
import Layout from '../layouts/Layout.astro';
import { path } from '../data/site';
---
<Layout title="Why Pardus" description="Pardus arranges flights, stays, transfers and experiences around your dates, budget and the people travelling." class="escape-inner" simpleFooter>
  <section class="escape-page-intro"><p class="eyebrow">Why Pardus</p><h1>Luxury travel.<br /><em>Less to think about.</em></h1><p>You tell us where you want to go. We bring the flights, hotels, transfers and experiences into one journey, planned around you.</p></section>
  <section class="escape-why escape-section"><div class="escape-why-grid"><div><h3>One point of contact</h3><p>Keep the itinerary, arrangements and practical questions in one conversation.</p></div><div><h3>Made around you</h3><p>Your dates, budget, occasion and fellow travellers shape the plan.</p></div><div><h3>Clear before you book</h3><p>Review your itinerary, USD price, inclusions, payment schedule and supplier terms before confirming.</p></div></div></section>
  <section class="escape-section"><h2>Beautiful places.<br /><em>Thoughtfully arranged.</em></h2><p class="escape-detail-note">Maldives and Seychelles island escapes. Dubai city breaks. East African safaris. Europe, family journeys and private time on the water.</p><a class="escape-underlined" href={path('journey.html')}>Plan your escape</a></section>
</Layout>
