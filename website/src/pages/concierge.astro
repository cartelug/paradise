---
import Layout from '../layouts/Layout.astro';
import { services } from '../data/offers';
import { path } from '../data/site';
---
<Layout title="What Pardus arranges" description="Flights, luxury hotels, private transfers, visa guidance, cruises, safaris, family holidays, honeymoons and corporate travel in one itinerary." class="escape-inner" simpleFooter>
  <section class="escape-page-intro"><p class="eyebrow">What we arrange</p><h1>You tell us where.<br /><em>We arrange everything.</em></h1><p>From the first flight to the last transfer. A complete holiday, a business itinerary or one experience that makes the trip.</p></section>
  <section class="escape-services escape-section"><ul class="escape-service-grid">{services.map((service,i) => <li><span>{String(i+1).padStart(2,'0')}</span>{service}</li>)}</ul><p class="escape-detail-note">You choose the services you need. Your proposal brings the itinerary, USD price, inclusions and terms together before anything is booked.</p></section>
  <section class="escape-overview escape-section"><div><p class="eyebrow">Travel for every occasion</p><h2>Your holiday.<br /><em>Your way to travel.</em></h2></div><div><h3>Couples & honeymoons</h3><p>Private island stays, beautiful hotels and romantic experiences, with the occasion considered.</p><h3>Families & groups</h3><p>Comfortable stays, practical transfers and activities around the people coming with you.</p><h3>Business travel</h3><p>Flights, hotels and ground arrangements coordinated around your schedule.</p><a class="escape-underlined" href={path('cruises.html')}>Explore private boat & yacht experiences</a></div></section>
  <section class="escape-enquiry-section escape-section"><div class="escape-enquiry-intro"><p class="eyebrow">One point of contact</p><h2>Start with a place.<br /><em>Leave the details with us.</em></h2><p>Let us know what you need and we’ll put a clear proposal together.</p></div><div><a class="escape-button" href={path('journey.html')}>Plan your escape</a></div></section>
</Layout>
