---
import Layout from '../layouts/Layout.astro';
import Picture from '../components/Picture.astro';
import Arrow from '../components/Arrow.astro';
import { destinations } from '../data/destinations';
import { site, path } from '../data/site';
---
<Layout title="Begin your journey" description="Create a personal Pardus journey brief, from destination and travel style to the details that make it yours." simpleFooter>
  <section class="planner-layout">
    <aside class="planner-aside"><p class="eyebrow">A thoughtful beginning</p><h1>Your next<br /><em>chapter.</em></h1><p>Tell us the shape of your escape. Start with a place, an occasion or simply the feeling you are looking for.</p><Picture name="maldives" alt="An overwater escape in the Maldives" class="planner-aside-picture" /><div class="planner-note"><span class="gold-rule"></span><p>{site.enquiryEndpoint ? 'This planner creates a brief you can keep, and sends your enquiry to Pardus. It does not confirm a booking.' : 'This planner creates a brief you can keep. It does not send an enquiry or confirm a booking.'}</p></div></aside>
    <form id="journey-planner" class="planner" novalidate action={site.enquiryEndpoint || undefined} method={site.enquiryEndpoint ? 'POST' : undefined}>
      <input type="hidden" name="_subject" value="Pardus journey brief" />
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="visually-hidden" />
      <div class="planner-progress"><span data-step-label>01 / 03 — The journey</span><div class="step-indicators" aria-hidden="true"><i class="active"></i><i></i><i></i></div></div>
      <fieldset data-step="1"><legend>Where does your mind wander?</legend>
        <label for="destination">Your destination</label><select name="destination" id="destination"><option>Open to inspiration</option>{destinations.map(d => <option data-slug={d.slug}>{d.name}</option>)}<option>Somewhere else</option></select>
        <label for="style">What brings you away?</label><select name="style" id="style"><option>A well-deserved escape</option><option>Honeymoon & celebration</option><option>Safari & adventure</option><option>Family & friends</option><option>Wellness & retreat</option><option>Corporate travel</option></select>
        <div class="form-row"><div><label for="travellers">Travellers</label><select name="travellers" id="travellers"><option>2 travellers</option><option>1 traveller</option><option>3–4 travellers</option><option>5+ travellers</option></select></div><div><label for="budget">Budget per person</label><select name="budget" id="budget"><option>Let’s discuss</option><option>Under USD 3,000</option><option>USD 3,000–7,000</option><option>USD 7,000–15,000</option><option>USD 15,000+</option></select></div></div>
      </fieldset>
      <fieldset data-step="2"><legend>A few personal details.</legend>
        <div class="form-row"><div><label for="date">Preferred departure <span>(optional)</span></label><input id="date" name="date" type="date" aria-describedby="planner-error" /></div><div><label for="nights">Length of stay</label><select name="nights" id="nights"><option>I’m flexible</option><option>3–5 nights</option><option>6–9 nights</option><option>10–14 nights</option><option>15+ nights</option></select></div></div>
        <label for="departure">Departure city <span>(optional)</span></label><input name="departure" id="departure" maxlength="120" placeholder="e.g. Entebbe" />
        <label for="notes">What would make it special? <span>(optional)</span> <span data-char-count class="small-caption">0/1500</span></label><textarea name="notes" id="notes" rows="4" maxlength="1500" placeholder="An occasion, a favourite kind of stay, or a wish you’ve had for a while…"></textarea>
      </fieldset>
      <fieldset data-step="3"><legend>A journey, taking shape.</legend><label for="name">Your name <span>(optional)</span></label><input id="name" name="name" autocomplete="name" maxlength="120" placeholder="How should we address you?" /><dl class="brief-summary"></dl><p class="local-notice">{site.enquiryEndpoint ? 'Your download is a personal planning brief—not a reservation. Submitting also sends your enquiry to Pardus. No payment is taken.' : 'Your download is a personal planning brief—not a reservation. Nothing is sent to Pardus. No payment is taken.'}</p></fieldset>
      <p class="form-error" id="planner-error" data-error role="alert"></p>
      <div class="planner-actions"><button type="button" class="planner-back" data-back hidden>Back</button><button type="submit" class="button" data-next><span>Add the details</span><Arrow /></button></div>
      <p class="form-status" data-form-status role="status"></p>
      <p class="form-footnote">{site.enquiryEndpoint ? 'Submitting sends your entries to Pardus to begin a conversation.' : 'Your entries stay in this page.'} <a href={path('privacy.html')}>Read our privacy information.</a></p>
      <noscript><p class="no-script-help">This planner needs JavaScript to create a downloadable brief. You can read the questions above and keep your own notes; no information is submitted.</p></noscript>
    </form>
    <pre class="print-brief" aria-hidden="true"></pre>
  </section>
  <section class="faq-section section-wrap"><div><p class="eyebrow">Before you begin</p><h2>A little<br /><em>clarity.</em></h2></div><div><details class="service-item"><summary><h3>Do I need to know where I want to go?</h3><span class="detail-toggle" aria-hidden="true"></span></summary><p>No. Choose “Open to inspiration” and share the occasion, atmosphere or travel style you have in mind.</p></details><details class="service-item"><summary><h3>Does downloading the brief make a booking?</h3><span class="detail-toggle" aria-hidden="true"></span></summary><p>{site.enquiryEndpoint ? 'No. Downloading the brief, and sending it to Pardus, does not reserve anything.' : 'No. The brief is saved on your device and is not sent automatically.'} Any arrangements, costs and availability must be discussed and confirmed separately.</p></details><details class="service-item"><summary><h3>Can I use this for business travel?</h3><span class="detail-toggle" aria-hidden="true"></span></summary><p>Yes. Select “Corporate travel” and include the schedule, traveller preferences and company requirements in your notes.</p></details></div></section>
</Layout>
