---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SimpleEnquiry from '../components/SimpleEnquiry.astro';
import Icon from '../components/Icon.astro';
import { path } from '../data/site';
---
<Layout label="Plan your escape" title="Plan your escape" description="Tell Pardus where you want to travel, your dates and budget. Prepare a simple travel enquiry and request a clear travel proposal in UGX." class="inner" simpleFooter>
  <PageHero eyebrow="Plan your escape" compact>
    <Fragment slot="title">Your next escape. <em>Let’s arrange it.</em></Fragment>
    <p class="lead">A destination, your dates and a little about who is travelling. A simple starting point for a beautiful journey.</p>
  </PageHero>
  <section class="sec sec--night" aria-labelledby="enquiry-title">
    <div class="wrap enquiry">
      <div class="enquiry-copy"><p class="eyebrow" data-reveal>One clear enquiry</p><h2 id="enquiry-title" data-split>You tell us where. <em>We arrange the rest.</em></h2><p class="lead" data-reveal>Request flights, stays, transfers, visa guidance and experiences in one proposal. Request your quote in UGX, with a USD reference when useful.</p><a class="link" href={path('planner.html')} data-reveal>Prefer a detailed journey brief? <Icon name="arrow-right" /></a></div>
      <div class="enquiry-card glass" data-reveal><SimpleEnquiry id="journey-enquiry" /></div>
    </div>
  </section>
</Layout>
