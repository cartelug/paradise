---
import Layout from '../layouts/Layout.astro';
import PremiumHero from '../components/PremiumHero.astro';
import SignatureEscape from '../components/SignatureEscape.astro';
import Picture from '../components/Picture.astro';
import Arrow from '../components/Arrow.astro';
import Brand from '../components/Brand.astro';
import OfferPrice from '../components/OfferPrice.astro';
import SimpleEnquiry from '../components/SimpleEnquiry.astro';
import TravelDesk from '../components/TravelDesk.astro';
import TravelIcon from '../components/TravelIcon.astro';
import { path } from '../data/site';
import { offerFor, destinationFor, priceText, priceNote, cruiseTypes } from '../data/offers';
import '../styles/premium-motion.css';
const families = [
  { title: 'Travel', icon: 'plane' as const, image: 'corporate', items: ['Flights', 'Private transfers', 'Visa guidance'] },
  { title: 'Stay', icon: 'sun' as const, image: 'maldives-v24', items: ['Luxury hotels & resorts', 'Stays chosen around you'] },
  { title: 'Experience', icon: 'waves' as const, image: 'yacht-dubai-v24', items: ['Boat & yacht cruises', 'Safaris & private tours', 'Activities & experiences'] },
  { title: 'Occasion', icon: 'compass' as const, image: 'europe-v24', items: ['Honeymoons', 'Family & group holidays', 'Corporate & custom travel'] },
];
---
<Layout dark simpleFooter premium class="escape-home premium-home" image="images/hero-v29-desktop-1600.webp">
  <PremiumHero />
  <nav class="premium-quick" aria-label="Popular escapes and starting prices">{['maldives', 'seychelles', 'dubai'].map(slug => { const offer = offerFor(slug); return <a href={path(`destination-${slug}.html`)}><div><span>{offer.label}</span><small>{offer.nights}</small></div><div><strong>{priceText(offer)}</strong><small>{offer.priceBasis}</small></div><Arrow /></a>; })}</nav>
  <section class="premium-featured premium-section" id="destinations" aria-labelledby="featured-title">
    <div class="premium-heading" data-premium-reveal><h2 id="featured-title">Your next escape<span class="premium-dot">.</span></h2><p>The Maldives or Seychelles.<br />Choose your setting. We arrange the journey.</p></div>
    <div class="premium-signatures">{['maldives', 'seychelles'].map(slug => <SignatureEscape offer={offerFor(slug)} />)}</div><p class="premium-price-note">{priceNote}</p>
  </section>
  <section class="premium-services premium-section" id="what-we-arrange" aria-labelledby="arrange-title">
    <div class="premium-heading" data-premium-reveal><h2 id="arrange-title">You choose where.<br /><em>We arrange the rest.</em></h2><p>A complete holiday, a business trip or one exceptional experience.</p></div>
    <div class="premium-service-list">{families.map((family, index) => <article data-premium-reveal><div class="premium-service-top"><span class="premium-index">0{index+1}</span><TravelIcon name={family.icon} /></div><h3>{family.title}</h3><Picture name={family.image} alt="" sizes="(max-width: 760px) 50vw, 25vw" /><ul>{family.items.map(item => <li>{item}</li>)}</ul></article>)}</div>
    <a class="premium-link" href={path('concierge.html')}>Explore our travel services <Arrow /></a>
  </section>
  <section class="premium-yacht" aria-labelledby="cruise-title">
    <div class="premium-yacht-image" data-premium-reveal="media"><Picture name="yacht-dubai-v24" alt="A white motor yacht in Dubai Marina" sizes="(max-width: 760px) 100vw, 56vw" /></div>
    <div class="premium-yacht-copy"><p class="premium-label">Private boat & yacht experiences</p><h2 id="cruise-title" data-premium-reveal>The best view<br />is <em>from the water.</em></h2><p>Dubai yacht cruises. Island excursions.<br />Sunset moments. Private celebrations.</p><div class="premium-yacht-rate"><strong>{priceText(cruiseTypes[0])}</strong><span>{cruiseTypes[0].basis}</span><span>UGX quote available</span></div><a class="premium-button" href={path('cruises.html')}>Explore private cruises <Arrow /></a></div>
  </section>
  <section class="premium-destinations premium-section" aria-labelledby="more-title">
    <div class="premium-heading" data-premium-reveal><h2 id="more-title">More places.<br /><em>More possibilities.</em></h2><a class="premium-link" href={path('destinations.html')}>All destinations <Arrow /></a></div>
    <div class="premium-destination-grid">{['dubai', 'africa', 'europe'].map(slug => { const offer = offerFor(slug); const destination = destinationFor(slug); return <article><a class="premium-destination-image" href={path(`destination-${slug}.html`)} data-premium-reveal="media"><Picture name={destination.image} alt={destination.alt} sizes="(max-width: 760px) 100vw, 33vw" /></a><div class="premium-destination-top"><h3><a href={path(`destination-${slug}.html`)}>{offer.label}</a></h3><span>{offer.nights}</span></div><p>{offer.experience}</p><OfferPrice offer={offer} /><a class="premium-link" href={path(`destination-${slug}.html`)}>Discover {offer.label} <Arrow /></a></article>; })}</div>
    <div class="premium-zanzibar"><span>Safari & Zanzibar</span><p>Start in safari country. Finish on the coast.</p><strong>{priceText(offerFor('zanzibar'))}</strong><a href={path('destination-zanzibar.html')} class="premium-link">Explore the journey <Arrow /></a></div>
  </section>
  <section class="premium-proof premium-section" aria-labelledby="why-title"><div class="premium-heading" data-premium-reveal><h2 id="why-title">Every detail,<br /><em>considered.</em></h2><Brand mark light /></div><div class="premium-proof-grid">{[['One conversation', 'Flights, stays, transfers and experiences brought into one clear plan.'], ['Made around you', 'Your dates, your budget and the people you are travelling with come first.'], ['Clear before you book', 'Review your itinerary, price, inclusions and terms before confirming.']].map(([title, text], index) => <article data-premium-reveal><span class="premium-index">0{index+1}</span><h3>{title}</h3><p>{text}</p></article>)}</div></section>
  <section class="premium-news premium-section" id="travel-desk" aria-labelledby="desk-title"><div class="premium-heading" data-premium-reveal><h2 id="desk-title">Know before<br /><em>you go.</em></h2><a class="premium-link" href={path('travel-desk.html')}>More travel updates <Arrow /></a></div><TravelDesk limit={3} /></section>
  <section class="premium-enquiry premium-section" id="enquire" aria-labelledby="enquire-title"><div class="premium-enquiry-copy"><p class="premium-label">Plan your escape</p><h2 id="enquire-title" data-premium-reveal>Tell us where.<br /><em>We’ll take it<br />from here.</em></h2><p>A destination, your dates and a little about your plans. That is all we need to start.</p><a class="premium-link" href={path('contact.html')}>Contact Pardus <Arrow /></a></div><SimpleEnquiry /></section>
  <script>import '../scripts/premium';</script>
</Layout>
