---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import WindowSeat from '../components/WindowSeat.astro';
import HomeEmblem from '../components/HomeEmblem.astro';
import Picture from '../components/Picture.astro';
import Icon from '../components/Icon.astro';
import Brand from '../components/Brand.astro';
import OfferPrice from '../components/OfferPrice.astro';
import SimpleEnquiry from '../components/SimpleEnquiry.astro';
import ServicePicker from '../components/ServicePicker.astro';
import StickyCta from '../components/StickyCta.astro';
import TravelDesk from '../components/TravelDesk.astro';
import BookingSteps from '../components/BookingSteps.astro';
import { journeys } from '../data/journeys';
import { path, site } from '../data/site';
import { offerFor, destinationFor, priceText, cruiseTypes } from '../data/offers';
import { photo } from '../data/photography.ts';
import heroArtwork from '../data/photographic-coast-artwork.json';
import illustrated from '../data/illustrated-home-artwork.json';
import { destinationArt } from '../data/home-illustrations';
const yachtPhoto = photo('yacht', { image: 'yacht-dubai-v24', alt: 'A white motor yacht in Dubai Marina' });
const promises = [
  { art: 'personal-attention', title: 'Personal attention', text: 'One adviser and one conversation, with flights, stays, transfers and experiences brought into one clear plan.' },
  { art: 'thoughtful-details', title: 'Thoughtful details', text: 'Your dates, your budget and the people you are travelling with come first.' },
  { art: 'seamless-service', title: 'Seamless service', text: 'Review your itinerary, price, inclusions and terms before confirming, and keep one point of contact throughout.' },
];
const asset = (name: string) => path(`images/${name}`);
const heroSet = (scene: 'desktop' | 'mobile') => (scene === 'mobile' ? illustrated.backgrounds['mobile-hero'] : heroArtwork.desktop).widths.map(width => `${asset(`${scene === 'mobile' ? 'pardus-v34-mobile-hero' : 'pardus-coastal-desktop'}-${width}.avif`)} ${width}w`).join(', ');
---
<Layout class="home" simpleFooter title="Luxury travel from Uganda and East Africa" label="Welcome" description={site.description} image={`images/pardus-coastal-desktop-${heroArtwork.desktop.width}.webp`}>
  <Fragment slot="head">
    <link rel="preload" as="image" type="image/avif" media="(max-width: 767px)" imagesrcset={heroSet('mobile')} imagesizes="100vw" />
    <link rel="preload" as="image" type="image/avif" media="(min-width: 768px)" imagesrcset={heroSet('desktop')} imagesizes="100vw" />
  </Fragment>
  <Hero />
  <WindowSeat />

  <section class="yacht" aria-labelledby="cruise-title" data-yacht>
    <div class="yacht-media"><Picture name={yachtPhoto.image} alt={yachtPhoto.alt} sizes="100vw" /></div>
    <div class="wrap">
      <p class="eyebrow" data-reveal>Private boat &amp; yacht experiences</p>
      <h2 id="cruise-title" data-split>The best view is <em>from the water.</em></h2>
      <p class="lead" data-reveal>Dubai yacht cruises. Island excursions. Sunset moments. Private celebrations.</p>
      <div class="yacht-rate" data-reveal><strong>{priceText(cruiseTypes[0])}</strong><span>{cruiseTypes[0].basis}</span><span>UGX quote available</span></div>
      <a class="btn btn--gold" href={path('cruises.html')} data-reveal>Explore private cruises <Icon name="arrow-right" /></a>
    </div>
  </section>

  <section class="sec sec--ivory blend-top" style="--blend:#050c1a" id="what-we-arrange" aria-labelledby="arrange-title">
    <div class="wrap services">
      <div class="services-intro">
        <p class="eyebrow" data-reveal>What we arrange</p>
        <h2 id="arrange-title" data-split>You choose where. <em>We arrange the rest.</em></h2>
        <p class="lead" data-reveal>Flights, stays, transfers, visas, cruises and more. Tap what you want and we bring it together in one clear proposal.</p>
        <ul class="services-points" data-reveal>
          <li><Icon name="chat" /><span><strong>One conversation</strong>for the whole trip</span></li>
          <li><Icon name="shield" /><span><strong>Price and inclusions</strong>before you decide</span></li>
          <li><Icon name="compass" /><span><strong>Made around you</strong>never a package</span></li>
        </ul>
        <a class="link services-more" href={path('concierge.html')} data-reveal>See everything we arrange <Icon name="arrow-right" /></a>
      </div>
      <ServicePicker illustrated />
    </div>
  </section>

  <section class="sec sec--sand" aria-labelledby="more-title">
    <div class="wrap">
      <div class="sec-head"><h2 id="more-title" data-split>More places. <em>More possibilities.</em></h2><p class="end" data-reveal><a class="link" href={path('destinations.html')}>All destinations <Icon name="arrow-right" /></a></p></div>
      <div class="dest-grid" data-stagger="130">
        {['africa', 'europe', 'zanzibar'].map(slug => { const offer = offerFor(slug); const place = destinationFor(slug); return (
          <article class="dest" data-reveal>
            <a class="frame" href={path(`destination-${slug}.html`)} aria-label={`Explore ${offer.label}`}><Picture name={place.image} alt={place.alt} sizes="(max-width: 900px) 100vw, 33vw" /></a>
            <div class="dest-top dest-top--illustrated"><HomeEmblem name={destinationArt[slug]} size={64} /><div><h3><a href={path(`destination-${slug}.html`)}>{offer.label}</a></h3><span class="dest-duration">{offer.nights}</span></div></div>
            <p>{offer.experience}</p>
            <OfferPrice offer={offer} />
            <a class="link" href={path(`destination-${slug}.html`)}>Discover {offer.label} <Icon name="arrow-right" /></a>
          </article>
        ); })}
      </div>
    </div>
    <div class="wrap signature">
      <div class="sec-head"><div><p class="eyebrow" data-reveal>Signature journeys</p><h2 id="journeys-title" data-split>Journeys with a <em>point of view.</em></h2></div><p class="end" data-reveal><a class="link" href={path('journeys.html')}>All signature journeys <Icon name="arrow-right" /></a></p></div>
      <div class="dest-grid" data-stagger="130">
        {journeys.slice(0, 3).map(journey => (
          <article class="dest" data-reveal>
            <a class="frame" href={path(`journey-${journey.slug}.html`)} aria-label={`Explore ${journey.name}`}><Picture name={journey.image} alt={journey.alt} sizes="(max-width: 900px) 100vw, 33vw" /></a>
            <div class="dest-top"><h3><a href={path(`journey-${journey.slug}.html`)}>{journey.name}</a></h3><span>{journey.eyebrow}</span></div>
            <p>{journey.description}</p>
            <a class="link" href={path(`journey-${journey.slug}.html`)}>Explore the idea <Icon name="arrow-right" /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec--night blend-top" style="--blend:#ebe2cf" aria-labelledby="why-title">
    <div class="wrap">
      <div class="promise-head"><h2 id="why-title" data-split>Every detail, <em>considered.</em></h2><Brand mark light /></div>
      <div class="promises" data-stagger="130">{promises.map(item => <article class="promise" data-reveal><HomeEmblem name={item.art} size={88} /><h3>{item.title}</h3><p>{item.text}</p></article>)}</div>
    </div>
    <div class="wrap booking" id="how-booking-works">
      <div class="sec-head"><div><p class="eyebrow" data-reveal>How booking works</p><h2 id="booking-title" data-split>Four steps. <em>One clear plan.</em></h2></div><p data-reveal>From your first message to the journey itself, with the terms in front of you before you commit.</p></div>
      <BookingSteps more />
    </div>
  </section>

  <section class="sec sec--lagoon" id="travel-desk" aria-labelledby="desk-title">
    <div class="wrap">
      <div class="sec-head"><h2 id="desk-title" data-split>Know before <em>you go.</em></h2><p class="end" data-reveal><a class="link" href={path('travel-desk.html')}>More travel updates <Icon name="arrow-right" /></a></p></div>
      <TravelDesk limit={3} />
    </div>
  </section>

  <section class="sec sec--dusk" id="enquire" aria-labelledby="enquire-title">
    <div class="wrap enquiry">
      <div class="enquiry-copy">
        <HomeEmblem name="travel-journal" size={112} />
        <p class="eyebrow" data-reveal>Plan your escape</p>
        <h2 id="enquire-title" data-split>Tell us where. <em>We’ll take it from here.</em></h2>
        <p class="lead" data-reveal>A destination, your dates and a little about your plans. That is all we need to start.</p>
        <a class="link" href={path('contact.html')} data-reveal>Contact Pardus <Icon name="arrow-right" /></a>
      </div>
      <div class="enquiry-card glass" data-reveal><SimpleEnquiry /></div>
    </div>
  </section>
  <StickyCta />
</Layout>
