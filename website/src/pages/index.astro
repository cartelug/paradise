---
import Layout from '../layouts/Layout.astro';
import Picture from '../components/Picture.astro';
import Brand from '../components/Brand.astro';
import EscapeCard from '../components/EscapeCard.astro';
import SimpleEnquiry from '../components/SimpleEnquiry.astro';
import TravelDesk from '../components/TravelDesk.astro';
import { path } from '../data/site';
import { offerFor, services } from '../data/offers';
---
<Layout dark simpleFooter class="escape-home">
  <section class="escape-hero" aria-labelledby="hero-title">
    <div class="escape-hero-media" data-scroll-media data-scroll-depth="20"><Picture name="maldives" alt="Overwater villas above the turquoise Indian Ocean in the Maldives" eager sizes="100vw" /></div>
    <div class="escape-hero-shade" aria-hidden="true"></div>
    <div class="escape-hero-copy"><p class="eyebrow">From Africa to the world</p><h1 id="hero-title">Luxury travel,<br /><em>beautifully</em><br />arranged.</h1><p class="escape-hero-description">Flights, exceptional stays and private experiences.<br class="desktop-only" /> You choose the destination. We take care of the details.</p><div class="escape-hero-actions"><a class="escape-button" href="#destinations">Explore destinations</a><a class="escape-button escape-button-outline" href="#enquire">Plan your escape</a></div></div>
    <div class="leopard-route" aria-hidden="true"><div class="leopard-traveller"><div class="leopard-sprite" style={`--leopard-sheet:url('${path('images/leopard-walk.webp')}')`}></div></div></div>
    <button class="motion-toggle requires-js" data-pause-leopard type="button" aria-pressed="false">Pause animation</button>
    <div class="escape-hero-bottom"><span>Maldives · Seychelles · Dubai · Beyond</span><a href="#destinations">Discover your next escape</a></div>
  </section>
  <section class="escape-featured escape-section" id="destinations" aria-labelledby="featured-title">
    <div class="escape-heading"><div><p class="eyebrow">The signature escapes</p><h2 id="featured-title">Two islands.<br /><em>Endless possibilities.</em></h2></div><p>The Maldives and Seychelles, arranged around you.<br />Choose your escape. We’ll put the journey together.</p></div>
    <div class="escape-featured-grid">{['maldives','seychelles'].map(slug => <EscapeCard offer={offerFor(slug)} featured />)}</div>
    <p class="escape-price-note">Your proposal confirms the USD price, flights, room type, transfers and experiences for your travel dates. Suggested stays can be tailored.</p>
  </section>
  <section class="escape-services escape-section" id="what-we-arrange" aria-labelledby="arrange-title">
    <div class="escape-heading"><div><p class="eyebrow">What Pardus arranges</p><h2 id="arrange-title">You choose where.<br /><em>We arrange the rest.</em></h2></div><p>A complete holiday, a business trip or one exceptional experience. Tell us what you need.</p></div>
    <ul class="escape-service-grid">{services.map((service, i) => <li data-reveal><span>{String(i + 1).padStart(2,'0')}</span>{service}</li>)}</ul>
    <a class="escape-underlined" href={path('concierge.html')}>Explore our travel services</a>
  </section>
  <section class="escape-cruise" aria-labelledby="cruise-title">
    <div class="escape-cruise-media" data-scroll-media data-scroll-depth="18"><Picture name="yacht-sunset" alt="A private motor yacht cruising across calm teal water at sunset" sizes="100vw" /></div><div class="escape-cruise-shade" aria-hidden="true"></div>
    <div class="escape-cruise-copy"><p class="eyebrow">Private boat & yacht experiences</p><h2 id="cruise-title">Your own<br /><em>piece of the ocean.</em></h2><p>Dubai yacht cruises. Island excursions. Sunset moments.<br />Private celebrations, beautifully arranged.</p><div class="escape-cruise-price"><strong>USD quote on request</strong><span>Choose your destination, group size and time on the water.</span></div><a class="escape-button" href={path('cruises.html')}>Explore private cruises</a></div>
  </section>
  <section class="escape-more escape-section" aria-labelledby="more-title">
    <div class="escape-heading"><div><p class="eyebrow">More places. More ways to escape.</p><h2 id="more-title">Where will you<br /><em>go next?</em></h2></div><a class="escape-underlined" href={path('destinations.html')}>All destinations</a></div>
    <article class="escape-dubai" data-reveal><a class="escape-dubai-image" href={path('destination-dubai.html')} aria-label="Explore Dubai"><Picture name="dubai" alt="Dubai skyline overlooking the water" sizes="(max-width: 760px) 100vw, 55vw" /></a><div class="escape-dubai-copy"><p class="eyebrow">The city escape · 4 nights</p><h3>Dubai, beautifully done.</h3><p>Luxury hotels. Shopping and dining. Desert experiences. A private yacht cruise. A short escape with something for everyone.</p><a class="escape-source-link" href="https://www.visitdubai.com/articles/events-to-look-forward-to-this-season" target="_blank" rel="noopener noreferrer">Explore Dubai’s current winter events · Visit Dubai</a><div class="escape-card-price"><div><span class="price-label">Your escape</span><strong>USD quote on request</strong></div><a class="escape-enquire" href={`${path('journey.html')}?destination=Dubai`}>Enquire</a></div></div></article>
    <div class="escape-secondary-grid">{['africa','zanzibar','europe'].map(slug => <EscapeCard offer={offerFor(slug)} />)}</div>
  </section>
  <section class="escape-why escape-section" aria-labelledby="why-title"><div class="escape-heading"><div><p class="eyebrow">Why Pardus</p><h2 id="why-title">A beautiful journey.<br /><em>A simpler way to plan.</em></h2></div><Brand mark /></div><div class="escape-why-grid">{[['One conversation','Flights, stays, transfers and experiences brought into one clear plan.'],['Made around you','Your dates, your budget and the people you are travelling with come first.'],['Clear before you book','Review your itinerary, USD price, inclusions and terms before confirming.']].map(([title,text],i) => <div data-reveal><span class="eyebrow">0{i+1}</span><h3>{title}</h3><p>{text}</p></div>)}</div></section>
  <section class="escape-news escape-section" id="travel-desk" aria-labelledby="desk-title"><div class="escape-heading"><div><p class="eyebrow">Pardus travel desk</p><h2 id="desk-title">Know before<br /><em>you go.</em></h2></div><a class="escape-underlined" href={path('travel-desk.html')}>More travel updates</a></div><TravelDesk limit={3} /></section>
  <section class="escape-enquiry-section escape-section" id="enquire" aria-labelledby="enquire-title"><div class="escape-enquiry-intro"><p class="eyebrow">Plan your escape</p><h2 id="enquire-title">Tell us where.<br /><em>We’ll take it from here.</em></h2><p>A destination, your dates and a little about your plans. That is all we need to start.</p><a class="escape-underlined" href={path('contact.html')}>Contact Pardus</a></div><SimpleEnquiry /></section>
</Layout>
