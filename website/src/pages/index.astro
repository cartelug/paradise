---
import Layout from '../layouts/Layout.astro';
import Picture from '../components/Picture.astro';
import SceneMedia from '../components/SceneMedia.astro';
import Horizon from '../components/Horizon.astro';
import Arrow from '../components/Arrow.astro';
import Brand from '../components/Brand.astro';
import { path } from '../data/site';
import { destinations } from '../data/destinations';
import { journeys } from '../data/journeys';
import { journal } from '../data/journal';
import '../styles/home.css';
const atlas = ['maldives', 'seychelles', 'zanzibar', 'africa', 'dubai', 'europe'].map(slug => destinations.find(d => d.slug === slug)!);
const notes = [journal.find(s => s.slug === 'choosing-your-maldives-island')!, journal.find(s => s.slug === 'what-a-private-safari-involves')!];
---
<Layout dark class="home-page" image="images/v20-horizon-desktop-1586.webp">
  <section class="v20-hero" aria-labelledby="hero-title">
    <Horizon />
    <div class="v20-hero-content">
      <h1 id="hero-title"><span class="visually-hidden">Pardus Luxury Escapes</span><span class="v20-wordmark" aria-hidden="true"><Brand vector light /></span><span class="v20-luxury" aria-hidden="true">Luxury Escapes</span></h1>
      <p class="v20-hero-line">A world away. <em>Entirely yours.</em></p>
      <p class="v20-hero-description">Private journeys, thoughtfully planned<br class="v20-mobile-break" /> from Africa to the world.</p>
      <a class="v20-button" href="#collection">Find your elsewhere <Arrow direction="down" /></a>
    </div>
    <div class="v20-hero-edge"><span>Personally planned</span><a href="#travel-explore">Scroll to explore <Arrow direction="down" /></a><span>Africa · Indian Ocean · Beyond</span></div>
  </section>
  <section class="v20-explore" id="travel-explore" aria-labelledby="travel-explore-title" data-v20-scroll-signature>
    <div class="v20-explore-frame">
      <SceneMedia name="section-3-sandbank" />
      <div class="v20-explore-fade" aria-hidden="true"></div>
      <svg class="v20-route" viewBox="0 0 1000 620" fill="none" aria-hidden="true"><path d="M70 480C180 350 280 425 385 300S585 180 705 242 840 180 935 80" pathLength="1"/><circle cx="70" cy="480" r="5"/><circle cx="385" cy="300" r="5"/><circle cx="935" cy="80" r="5"/></svg>
      <div class="v20-explore-copy"><h2 id="travel-explore-title"><span>Travel.</span><em>Explore.</em></h2><p>Find the place that changes your pace.</p></div>
      <div class="v20-explore-bottom"><div><span>The wild</span><span>The water</span><span>The world beyond</span></div><a class="text-button" href="#collection">Explore destinations <Arrow /></a></div>
    </div>
  </section>
  <section class="v20-atlas v20-section" id="collection" aria-labelledby="atlas-title">
    <div class="v20-heading"><h2 id="atlas-title">Where would you <em>rather be?</em></h2><a class="text-button" href={path('destinations.html')}>View all destinations <Arrow /></a></div>
    <div class="v20-atlas-layout" data-destination-editor>
      <div class="v20-atlas-tabs" role="tablist" aria-label="Featured destinations" aria-orientation="vertical">{atlas.map((d, i) => <button id={`tab-${d.slug}`} role="tab" aria-controls={`panel-${d.slug}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-destination-tab={d.slug}><span>{d.name}<small>{d.country}</small></span><Arrow /></button>)}</div>
      <div class="v20-atlas-stage">{atlas.map((d, i) => <article id={`panel-${d.slug}`} role="tabpanel" aria-labelledby={`tab-${d.slug}`} data-panel={d.slug} hidden={i !== 0}>
        <a class="v20-atlas-image" href={path(`destination-${d.slug}.html`)} aria-label={`Explore ${d.name}`}><Picture name={d.image} alt={d.alt} sizes="(max-width: 760px) 100vw, 65vw" /><span>{d.caption}</span></a>
        <div class="v20-atlas-caption"><div><h3>{d.mood}</h3><p>{d.suggestedStay}</p></div><a class="text-button" href={path(`destination-${d.slug}.html`)}>Discover {d.name.replace('The ', 'the ')} <Arrow /></a></div>
      </article>)}</div>
    </div>
    <noscript><p class="no-script-help">Browse all six places in the <a href={path('destinations.html')}>destination collection</a>.</p></noscript>
  </section>
  <section class="v20-journeys v20-section" aria-labelledby="home-journeys-title">
    <div class="v20-heading"><h2 id="home-journeys-title">Some journeys<br /><em>stay with you.</em></h2><div><p>A starting point for something personal.</p><a class="text-button" href={path('journeys.html')}>Explore all journeys <Arrow /></a></div></div>
    <div class="v20-journey-grid">{journeys.slice(0,3).map(journey => <article class="home-concept-card v20-concept">
      <a class="v20-concept-image" href={path(`journey-${journey.slug}.html`)} aria-label={`Explore ${journey.name}`}><Picture name={journey.image} alt={journey.alt} sizes="(max-width: 760px) 100vw, 45vw" /></a>
      <p class="eyebrow">{journey.eyebrow}</p><h3><a href={path(`journey-${journey.slug}.html`)}>{journey.name}</a></h3><p class="v20-concept-duration">{journey.duration.replace('Suggested rhythm / ', '')}<span> · {journey.pace} pace</span></p>
      <div class="v20-concept-actions"><a class="text-button" href={path(`journey-${journey.slug}.html`)}>Explore the journey <Arrow /></a><button type="button" class="folio-save requires-js" data-folio-save={journey.slug} data-folio-type="journey" data-folio-label={journey.name} aria-pressed="false" aria-label={`Save ${journey.name} to your Folio`}><span data-save-label>Save</span><span aria-hidden="true">+</span></button></div>
    </article>)}</div>
  </section>
  <section class="v20-folio v20-section" id="folio-builder" aria-labelledby="folio-builder-title">
    <div class="v20-folio-intro"><Brand mark light /><h2 id="folio-builder-title">Tell us what<br /><em>draws you.</em></h2><p>Choose a place, a pace, a reason.<br />Your Folio keeps the ideas together.</p><a class="v20-about-link" href={path('about.html')}>Discover the Pardus way <Arrow /></a></div>
    <div class="v20-folio-controls"><div class="v20-choice-rows requires-js">
      <fieldset><legend>Place</legend><div>{['Island','Wild','City','Culture','Open'].map(item => <button type="button" data-folio-choice="place" data-value={item} aria-pressed="false">{item}</button>)}</div></fieldset>
      <fieldset><legend>Pace</legend><div>{['Still','Balanced','Immersive'].map(item => <button type="button" data-folio-choice="pace" data-value={item} aria-pressed="false">{item}</button>)}</div></fieldset>
      <fieldset><legend>Reason</legend><div>{['Escape','Celebration','Family','Business'].map(item => <button type="button" data-folio-choice="reason" data-value={item} aria-pressed="false">{item}</button>)}</div></fieldset>
    </div><button type="button" class="v20-button requires-js" data-folio-trigger>Review your Folio <Arrow /></button><noscript><p>A place, a pace, a reason. Begin with whatever you know.</p><a class="v20-button" href={path('journey.html')}>Begin a journey brief <Arrow /></a></noscript><p class="v20-folio-note">Ideas are saved on this device. You can change them any time.</p></div>
  </section>
  <section class="v20-notes v20-section" aria-labelledby="notes-title">
    <div class="v20-heading"><div><p class="eyebrow">The Pardus journal</p><h2 id="notes-title">Before you <em>go.</em></h2></div><a class="text-button" href={path('journal.html')}>Read the journal <Arrow /></a></div>
    <div class="v20-note-grid">{notes.map(story => <article><a href={path(`journal-${story.slug}.html`)}><div class="v20-note-image"><Picture name={story.image} alt={story.alt} sizes="(max-width: 760px) 100vw, 50vw" /></div><p class="eyebrow">{story.category}</p><h3>{story.title}<Arrow /></h3></a></article>)}</div>
  </section>
</Layout>
