---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SimpleEnquiry from '../components/SimpleEnquiry.astro';
import Icon from '../components/Icon.astro';
import { cruiseTypes, priceText, usd } from '../data/offers';
const cruiseIcons = ['yacht', 'heart', 'compass', 'sparkle'] as const;
---
<Layout label="Private cruises" title="Private boat & yacht experiences" description="Private Dubai yacht cruises, sunset cruises, island excursions and private celebrations, arranged by Pardus Luxury Escapes." class="inner cruise-page" simpleFooter>
  <PageHero glance image="yacht-dubai-v24" alt="A white motor yacht leaving Dubai Marina in warm sunset light" eyebrow="Private boat & yacht experiences" focusX="60%" focusY="55%">
    <Fragment slot="title">Out on the water. <em>Entirely your own.</em></Fragment>
    <p class="lead">For a romantic evening, an island adventure or a celebration with your favourite people.</p>
  </PageHero>

  <section class="sec sec--ivory glance-sec" aria-label="Dubai private yacht cruise">
    <div class="wrap glance">
      <div class="glance-card on-dark" data-reveal>
        <div><span class="card-label">Dubai private yacht cruise</span>
          <ul class="incl"><li><Icon name="yacht" /><span>Your own yacht</span></li><li><Icon name="clock" /><span>3 hours on the water</span></li><li><Icon name="users" /><span>Up to 6 guests</span></li></ul></div>
        <div class="glance-booking"><div class="price"><span class="price-label">From</span><strong>{usd(cruiseTypes[0].fromUSD)}</strong><small>per yacht, private charter</small></div><a class="btn btn--gold" href="#cruise-enquiry">Plan your cruise <Icon name="arrow-down" /></a></div>
      </div>
    </div>
    <div class="wrap">
      <p class="eyebrow" data-reveal>Choose your experience</p>
      <h2 data-split>More than a boat trip. <em>A moment to keep.</em></h2>
      <div class="exp-grid exp-grid--2" data-stagger="110">{cruiseTypes.map((type, i) => <article class="exp" data-reveal><span class="badge"><Icon name={cruiseIcons[i]} /></span><h3>{type.title}</h3><p>{type.text}</p><div class="exp-price"><strong>{priceText(type)}</strong><small>{type.basis}</small></div></article>)}</div>
      <p class="note">Choose your destination, date, group size and occasion. Your proposal confirms the vessel, route, duration, inclusions and total USD price. Sailings depend on local conditions and availability.</p>
    </div>
  </section>

  <section class="sec sec--dusk" id="cruise-enquiry" aria-labelledby="cruise-enquiry-title">
    <div class="wrap enquiry">
      <div class="enquiry-copy"><p class="eyebrow" data-reveal>Your private cruise</p><h2 id="cruise-enquiry-title" data-split>Pick the occasion. <em>We’ll plan the water.</em></h2><p class="lead" data-reveal>Dubai, the Maldives, Seychelles or an island excursion. Tell us what you have in mind.</p></div>
      <div class="enquiry-card glass" data-reveal><SimpleEnquiry id="cruise-enquiry-form" defaultDestination="Private boat & yacht experience" /></div>
    </div>
  </section>
</Layout>
