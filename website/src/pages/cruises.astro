---
import Layout from '../layouts/Layout.astro';
import Picture from '../components/Picture.astro';
import SimpleEnquiry from '../components/SimpleEnquiry.astro';
import { cruiseTypes, priceText, usd } from '../data/offers';
import TravelIcon from '../components/TravelIcon.astro';
---
<Layout title="Private boat & yacht experiences" description="Private Dubai yacht cruises, sunset cruises, island excursions and private celebrations, arranged by Pardus Luxury Escapes." class="escape-inner destination-page cruise-page" simpleFooter>
  <header class="destination-intro"><div class="destination-intro-media"><Picture name="yacht-dubai-v24" alt="A white motor yacht leaving Dubai Marina in warm sunset light" eager sizes="(max-width: 760px) 100vw, 55vw" /></div><div class="destination-intro-copy"><p class="eyebrow">Private boat & yacht experiences</p><h1>Out on the water.<br /><em>Entirely your own.</em></h1><p>For a romantic evening, an island adventure or a celebration with your favourite people.</p></div></header>
  <section class="destination-summary escape-section" aria-label="Dubai private yacht cruise"><div><p class="escape-block-label">Dubai private yacht cruise</p><ul class="escape-inclusions inclusion-list"><li><TravelIcon name="waves" /><span>Your own yacht</span></li><li><TravelIcon name="sun" /><span>3 hours on the water</span></li><li><TravelIcon name="compass" /><span>Up to 6 guests</span></li></ul></div><div class="destination-summary-booking"><div class="offer-price"><span class="price-label">From</span><strong>{usd(cruiseTypes[0].fromUSD)}</strong><small>per yacht · private charter</small></div><a class="escape-button" href="#cruise-enquiry">Plan your cruise <TravelIcon name="arrow" /></a></div></section>
  <section class="escape-possibilities escape-section"><p class="eyebrow">Choose your experience</p><h2>More than a boat trip.<br /><em>A moment to keep.</em></h2><div class="escape-experience-grid escape-cruise-grid">{cruiseTypes.map((type, i) => <article data-reveal><span class="experience-number">0{i+1}</span><h3>{type.title}</h3><p>{type.text}</p><div class="cruise-price"><strong>{priceText(type)}</strong><small>{type.basis}</small></div></article>)}</div><p class="escape-detail-note">Choose your destination, date, group size and occasion. Your proposal confirms the vessel, route, duration, inclusions and total USD price. Sailings depend on local conditions and availability.</p></section>
  <section class="escape-enquiry-section escape-section" id="cruise-enquiry"><div class="escape-enquiry-intro"><p class="eyebrow">Your private cruise</p><h2>Pick the occasion.<br /><em>We’ll plan the water.</em></h2><p>Dubai, the Maldives, Seychelles or an island excursion. Tell us what you have in mind.</p></div><SimpleEnquiry id="cruise-enquiry-form" defaultDestination="Private boat & yacht experience" /></section>
</Layout>
