---
import Layout from '../layouts/Layout.astro';
import Picture from '../components/Picture.astro';
import SimpleEnquiry from '../components/SimpleEnquiry.astro';
import { cruiseTypes } from '../data/offers';
---
<Layout title="Private boat & yacht experiences" description="Private Dubai yacht cruises, sunset cruises, island excursions and private celebrations, arranged by Pardus Luxury Escapes." class="escape-inner" simpleFooter>
  <section class="escape-detail-hero"><Picture name="yacht-sunset" alt="A private yacht on calm ocean water at sunset" eager sizes="100vw" /><div class="escape-detail-heading"><p class="eyebrow">Private boat & yacht experiences</p><h1>Out on the water.<br /><em>Entirely your own.</em></h1><p>For a romantic evening, an island adventure or a celebration with your favourite people.</p><div class="escape-detail-offer"><div><strong>USD quote on request</strong><small>Private arrangements · Flexible duration</small></div><a class="escape-button" href="#cruise-enquiry">Plan your private cruise</a></div></div></section>
  <section class="escape-possibilities escape-section"><p class="eyebrow">Choose your experience</p><h2>More than a boat trip.<br /><em>A moment to keep.</em></h2><div class="escape-experience-grid escape-cruise-grid">{cruiseTypes.map(type => <div data-reveal><h3>{type.title}</h3><p>{type.text}</p></div>)}</div><p class="escape-detail-note">Tell us the destination, date, group size and occasion. Your proposal confirms the vessel, route, duration, transfers, catering where requested, and total USD price. Sailings depend on local conditions and availability.</p></section>
  <section class="escape-enquiry-section escape-section" id="cruise-enquiry"><div class="escape-enquiry-intro"><p class="eyebrow">Your private cruise</p><h2>Pick the occasion.<br /><em>We’ll plan the water.</em></h2><p>Dubai, the Maldives, Seychelles or an island excursion. Tell us what you have in mind.</p></div><SimpleEnquiry id="cruise-enquiry-form" defaultDestination="Private boat & yacht experience" /></section>
</Layout>
