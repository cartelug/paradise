---
import '../styles/base.css';
import '../styles/chrome.css';
import '../styles/hero.css';
import '../styles/home.css';
import '../styles/pages.css';
import '../styles/motion.css';
import '../styles/preloader.css';
import FontFaces from '../components/FontFaces.astro';
import CinematicIntro from '../components/CinematicIntro.astro';
import IconSprite from '../components/IconSprite.astro';
import BrandSprite from '../components/BrandSprite.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Folio from '../components/Folio.astro';
import { site, path, absolute, socialLinks } from '../data/site';
interface Props { title?: string; label?: string; description?: string; image?: string; simpleFooter?: boolean; class?: string; }
const { title, label, description = site.description, image = 'images/pardus-hero-desktop-v25-1536.webp', simpleFooter = false, class: className } = Astro.props;
// The preloader names the page that is opening.
const introLabel = label ?? (title ? title.split(/ [—:] /)[0] : 'Welcome');
// GitHub Pages serves the homepage at the bare base path; every other route keeps its real .html filename.
const canonical = new URL(Astro.url.pathname.replace(/index\.html$/, ''), Astro.site);
const ogImage = absolute(image);
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  '@id': `${canonical.origin}${path()}#organization`,
  name: site.name,
  description: site.description,
  url: `${canonical.origin}${path()}`,
  logo: absolute('brand/pardus-primary-512.png'),
  ...(site.email ? { email: site.email } : {}),
  ...(socialLinks.length ? { sameAs: socialLinks.map(link => link.href) } : {}),
};
// HARD RULE: the preloader runs on every page (CLAUDE.md). This inline script only decides, before first paint, which version:
// the full sequence on the first page of a visit, the quick one afterwards. It also carries a failsafe that releases the page
// even if the main script fails.
const bootstrap = `(()=>{const r=document.documentElement;r.classList.add('js');try{const seen=!!sessionStorage.getItem('pardus-intro-v30');r.classList.add('intro-active',seen?'intro-quick':'intro-full');r.dataset.introStarted=String(performance.now());r.dataset.introFailsafe=String(setTimeout(()=>{r.classList.remove('intro-active','intro-exiting');r.classList.add('is-ready');document.querySelector('[data-pardus-shell]')?.removeAttribute('inert');},seen?4500:7500));}catch{r.classList.add('is-ready');}})();`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#050c1a" />
    <meta name="color-scheme" content="dark light" />
    <meta name="description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <FontFaces hero />
    <slot name="head" />
    <title>{title ? (`${title} — ${site.name}`.length > 60 ? `${title} — Pardus` : `${title} — ${site.name}`) : site.name}</title>
    <link rel="icon" type="image/svg+xml" href={path('brand/favicon.svg')} />
    <link rel="apple-touch-icon" href={path('brand/apple-touch-icon.png')} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ? `${title} — Pardus` : site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ? `${title} — Pardus` : site.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {site.analyticsId && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${site.analyticsId}"}`}></script>}
    <script is:inline set:html={bootstrap} />
  </head>
  <body id="top" class={className} data-pardus-version="30">
    <IconSprite />
    <BrandSprite />
    <CinematicIntro label={introLabel} />
    <div data-pardus-shell>
      <Header />
      <Folio />
      <main id="main" tabindex="-1"><slot /></main>
      <Footer simple={simpleFooter} />
    </div>
    <script>import '../scripts/site.ts';</script>
    <script>import '../scripts/preloader.ts';</script>
  </body>
</html>
