---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/wght-italic.css';
import '../styles/site.css';
import '../styles/refinements.css';
import '../styles/luxury.css';
import '../styles/cinematic.css';
import '../styles/studio.css';
import '../styles/atelier.css';
import '../styles/polish.css';
import CinematicIntro from '../components/CinematicIntro.astro';
import BrandSprite from '../components/BrandSprite.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Folio from '../components/Folio.astro';
import { site, path, absolute, socialLinks } from '../data/site';
interface Props { title?: string; description?: string; image?: string; dark?: boolean; simpleFooter?: boolean; class?: string; intro?: boolean; }
const { title, description = site.description, image = 'images/hero-v27-desktop-1672.webp', dark = false, simpleFooter = false, class: className, intro = false } = Astro.props;
// GitHub Pages serves the homepage at the bare base path; every other route keeps its real .html filename.
const canonical = new URL(Astro.url.pathname.replace(/index\.html$/, ''), Astro.site);
const ogImage = absolute(image);
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  '@id': `${canonical.origin}${path()}#organization`,
  name: site.name,
  description: site.description,
  url: `${canonical.origin}${path()}`,
  logo: absolute('brand/pardus-primary-512.png'),
  ...(site.email ? { email: site.email } : {}),
  ...(socialLinks.length ? { sameAs: socialLinks.map(link => link.href) } : {}),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#071426" />
    <meta name="description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="preload" href={path('fonts/Satoshi-Light.woff2')} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={path('fonts/Satoshi-Regular.woff2')} as="font" type="font/woff2" crossorigin="anonymous" />
    <style is:inline set:html={`
      @font-face{font-family:'Satoshi';src:url('${path('fonts/Satoshi-Light.woff2')}') format('woff2');font-style:normal;font-weight:300;font-display:swap;}
      @font-face{font-family:'Satoshi';src:url('${path('fonts/Satoshi-Regular.woff2')}') format('woff2');font-style:normal;font-weight:400;font-display:swap;}
      @font-face{font-family:'Satoshi';src:url('${path('fonts/Satoshi-Medium.woff2')}') format('woff2');font-style:normal;font-weight:500 600;font-display:swap;}
      @font-face{font-family:'Satoshi';src:url('${path('fonts/Satoshi-Bold.woff2')}') format('woff2');font-style:normal;font-weight:700 900;font-display:swap;}
      @font-face{font-family:'Montserrat';src:url('${path('fonts/Montserrat-Variable.woff2')}') format('woff2');font-style:normal;font-weight:100 900;font-display:swap;}
    `} />
    <title>{title ? (`${title} — ${site.name}`.length > 60 ? `${title} — Pardus` : `${title} — ${site.name}`) : site.name}</title>
    <link rel="icon" type="image/svg+xml" href={path('brand/favicon.svg')} />
    <link rel="apple-touch-icon" href={path('brand/apple-touch-icon.png')} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ? `${title} — Pardus` : site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ? `${title} — Pardus` : site.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {site.analyticsId && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${site.analyticsId}"}`}></script>}
    <script is:inline>document.documentElement.classList.add('js', 'page-ready');</script>
    {intro && <script is:inline>
      (()=>{try{if(!matchMedia('(prefers-reduced-motion: reduce)').matches&&!sessionStorage.getItem('pardus-intro-v27')){document.documentElement.classList.add('intro-active');document.documentElement.dataset.introStarted=String(performance.now());document.documentElement.dataset.introFailsafe=String(setTimeout(()=>{document.documentElement.classList.remove('intro-active','intro-exiting');document.documentElement.classList.add('cinema-arrived');document.querySelector('[data-pardus-shell]')?.removeAttribute('inert');},6000));}}catch{document.documentElement.classList.add('cinema-arrived');}})();
    </script>}
  </head>
  <body id="top" class={className} data-pardus-version="27">
    <BrandSprite />
    {intro && <CinematicIntro />}
    <div data-pardus-shell>
    <div class="page-progress" aria-hidden="true"><span></span></div>
    <Header dark={dark} />
    <Folio />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer simple={simpleFooter} />
    </div>
    <script>import '../scripts/site.ts';</script>
    <script>import '../scripts/cinematic.ts';</script>
  </body>
</html>
