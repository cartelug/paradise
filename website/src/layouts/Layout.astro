---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/wght-italic.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Preloader from '../components/Preloader.astro';
import { site, path } from '../data/site';
interface Props { title?: string; description?: string; image?: string; dark?: boolean; simpleFooter?: boolean; class?: string; }
const { title, description = site.description, image = 'images/pardus-hero-desktop-1920.webp', dark = false, simpleFooter = false, class: className } = Astro.props;
// GitHub Pages serves the homepage at the bare base path; every other route keeps its real .html filename.
const canonical = new URL(Astro.url.pathname.replace(/index\.html$/, ''), 'https://cartelug.github.io');
const ogImage = new URL(path(image), 'https://cartelug.github.io').toString();
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  '@id': `${canonical.origin}${path()}#organization`,
  name: site.name,
  description: site.description,
  url: `${canonical.origin}${path()}`,
  logo: new URL(path('brand/pardus-primary-512.png'), 'https://cartelug.github.io').toString(),
  ...(site.email ? { email: site.email } : {}),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#071D2B" />
    <meta name="description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=satoshi@300,400,500,600,700&display=swap" />
    <link rel="preload" href={path('fonts/Montserrat-VariableFont_wght.ttf')} as="font" type="font/ttf" crossorigin="anonymous" />
    <style is:inline set:html={`@font-face{font-family:'Montserrat';src:url('${path('fonts/Montserrat-VariableFont_wght.ttf')}') format('truetype');font-style:normal;font-weight:100 900;font-display:swap;}`} />
    <title>{title ? `${title} — ${site.name}` : site.name}</title>
    <link rel="icon" type="image/svg+xml" href={path('brand/favicon.svg')} />
    <link rel="apple-touch-icon" href={path('brand/apple-touch-icon.png')} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ? `${title} — Pardus` : site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ? `${title} — Pardus` : site.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {site.analyticsId && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${site.analyticsId}"}`}></script>}
    <script is:inline src={path('opening.js')}></script>
  </head>
  <body id="top" class={className}>
    <div class="page-progress" aria-hidden="true"><span></span></div>
    <Preloader />
    <Header dark={dark} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer simple={simpleFooter} />
    <script>import '../scripts/site.ts';</script>
  </body>
</html>
